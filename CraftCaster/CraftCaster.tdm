ConceptualModel CraftCaster {
    
    Enumeration Rareza
    {
        (Comun, 1), (Especial, 2), (Epico, 3), (Legendario, 4)
    };

    Enumeration Tipo
    {
        (Hechizo, 1), (Monstruo, 2)
    };
    
    Class User <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private name : String (1, 1);
            private password : Password (1, 1);
            
        }
        
        operations
        {
            public new::New (p_name : String, p_password : Password) : Object->User;
            public destroy::Destroy (p_oid : OID -> User) : Void;
            public modify::Modifier (p_oid : OID -> User, p_name : String, p_password : Password) : Void;
            public login::Login (p_oid : OID -> User, p_password : Password) : String;
            
        
        }
    };

    Class Deck
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
        }
        
        operations
        {
            
        }
    };

    Class Card
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private rareza : Rareza (1, 1);
            private mana : Integer (1, 1);

        }
        
        operations
        {
            
        }
    };

    Class Hability
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
        }
        
        operations
        {
            
        }
    };

    Class Game
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
        }
        
        operations
        {
            
        }
    };

    Class GameEntity
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
        }
        
        operations
        {
            
        }
    };

    Class Player extends GameEntity
    {
        attributes
        {
            
        }
        
        operations
        {
            
        }
    };

    Class Spell extends GameEntity
    {
        attributes
        {
            
        }
        
        operations
        {
            
        }
    };

    //Relaciones

    Association UserCard (User - Card)
    {
        => navigable Cartas : Share (0, *);
        <= navigable Usuario (1, 1);
    };

    Association UserDeck (User - Deck)
    {
        => navigable Mazos : Share (0, *);
        <= navigable Usuario (1, 1);
    };

    Association DeckCard (Deck - Card)
    {
        => navigable Cartas : Share (0, *);
        <= navigable Mazo (1, 1);
    };

    Association UserGame (User - Game)
    {
        => navigable Partidas (0, *);
        <= navigable Usuario (1, *);
    };

    Association DeckGame (Deck - Game)
    {
        => navigable Partidas (0, *);
        <= navigable Mazo (1, *);
    };
    

    Association GameGameEntity (Game - GameEntity)
    {
        => navigable Entidades : Composite (0, *);
        <= navigable Partida (1, 1);
    };

    Association CardHability (Card - Hability)
    {
        => navigable Habilidades : Share (0, *);
        <= navigable Carta (1, 1);
    };
    
    
    
    
    
    

    
}
