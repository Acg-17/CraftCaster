ConceptualModel CraftCaster {
    
    Enumeration Rareza
    {
        (Comun, 1), (Especial, 2), (Epico, 3), (Legendario, 4)
    };

    Enumeration EstadoCuenta
    {
        (Activa, 1), (Suspendida, 2)
    };

    Enumeration EstadoMazo
    {
        (Incompleto, 1), (Jugable, 2), (Completo, 3), (Deshabilitado, 4)
    };
    
    Enumeration EstadoPartida
    {
        (Espera, 1), (EnCurso, 2), (Finalizada, 3)
    };

    Enumeration TipoZona
    {
        (Mano, 1), (Campo, 2), (Descarte, 3), (Mazo, 4)
    };

    Enumeration TipoUsuario
    {
        (Cliente, 1), (Admin, 2)
    };

    Enumeration TipoCarta
    {
        (Criatura, 1), (Hechizo, 2)
    };

    Enumeration TipoEstado
    {
        (Entrar, 1), (Atacar, 2), (InicioTurno, 3), (FinTurno, 4), (Morir, 5)
    };

    Enumeration TipoHabilidad
    {
        (Elem1, 1), (Elem2, 2)
    };

    Enumeration TipoAccion
    {
        (Ataque, 1), (Lanzar, 2), (Disparada, 3)
    };

    Enumeration Objetivo
    {
        (Jugador, 1), (Enemigo, 2), (Libre, 3), (TodosEnemigos, 4), (Self, 5) 
    };

    Class Usuario <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private nombreUsuario : String (1, 1);
            private email : String (1, 1);
            private contrasenia : Password (1, 1);

            private fotoPerfil : Byte (1, 1);

            private nivel : Integer (1, 1);
            private exp : Integer (1, 1);
        }
        
        operations
        {
            public new::New (p_nombreUsuario : String, p_email : String, p_contrasenia : Password, p_fotoPerfil : Byte, p_nivel : Integer, p_exp : Integer) : Object->Usuario;
            public destroy::Destroy (p_oid : OID -> Usuario) : Void;
            public modify::Modifier (p_oid : OID -> Usuario, p_nombreUsuario : String, p_email : String, p_contrasenia : Password, p_fotoPerfil : Byte, p_nivel : Integer, p_exp : Integer) : Void;
            public readOID::ReadOID (p_oid : OID -> Usuario) : Object->Usuario;
            public readAll::ReadAll () : List<Object->Usuario>;

            public login::Login (p_oid : OID -> Usuario, p_contrasenia : Password) : String;

            public addCarta::Relationer -> UsuarioCarta.cartas (p_oid : OID -> Usuario, p_carta_oids : List<OID -> Carta>) : Void;
        }
    };

    Class Mazo
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);

            private nombre : String (1, 1);
            private costeMedio : Float (1, 1);
            private numCartas : Integer (1, 1);
            private estadoMazo : EstadoMazo (1, 1);
            private esPublico : Boolean (1, 1);

            private valoracion : Float (1, 1);
            private imagen : Byte (1, 1);
            private creador : String (1, 1);
        }
        
        operations
        {
            public new::New (p_nombre : String, p_costeMedio : Float, p_numCartas : Integer, p_estadoMazo : EstadoMazo, p_esPublico : Boolean, p_valoracion : Float, p_imagen : Byte, p_creador : String, p_usuario_oid : OID -> Usuario) : Object->Mazo;
            public destroy::Destroy (p_oid : OID -> Mazo) : Void;
            public modify::Modifier (p_oid : OID -> Mazo, p_nombre : String, p_costeMedio : Float, p_numCartas : Integer, p_estadoMazo : EstadoMazo, p_esPublico : Boolean, p_valoracion : Float, p_imagen : Byte, p_creador : String, p_usuario_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Mazo) : Object->Mazo;
            public readAll::ReadAll () : List<Object->Mazo>;

            public compartir::Custom (p_oid : OID -> Mazo) : Void;
        }
    };

    Class Carta
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1);
            private rareza : Rareza (1, 1);
            private costeMana : Integer (1, 1);
            private tipo : TipoCarta (1, 1);
            private vida : Integer (0, 1);
            private ataque : Integer (0, 1);

            private descripcion : String (1, 1);
            private imagen : Byte (1, 1);
            private esPublica : Boolean (1, 1);
        }
        
        operations
        {
            public new::New (p_nombre : String, p_rareza : Rareza, p_costeMana : Integer, p_tipo : TipoCarta, p_descripcion : String, p_imagen : Byte, p_esPublica : Boolean, p_usuario_oid : OID -> Usuario, p_mazo_oid : OID -> Mazo) : Object->Carta;
            public destroy::Destroy (p_oid : OID -> Carta) : Void;
            public modify::Modifier (p_oid : OID -> Carta, p_nombre : String, p_rareza : Rareza, p_costeMana : Integer, p_tipo : TipoCarta, p_descripcion : String, p_imagen : Byte, p_esPublica : Boolean, p_usuario_oid : OID -> Usuario, p_mazo_oid : OID -> Mazo) : Void;
            public readOID::ReadOID (p_oid : OID -> Carta) : Object->Carta;
            public readAll::ReadAll () : List<Object->Carta>;

            public compartir::Custom (p_oid : OID -> Carta) : Void;
        }
    };

    Class Estado
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private tipo : TipoEstado (1, 1);
        }
        
        operations
        {
            public new::New (p_tipo : TipoEstado, p_carta_oid : OID -> Carta) : Object->Estado;
            public destroy::Destroy (p_oid : OID -> Estado) : Void;
            public modify::Modifier (p_oid : OID -> Estado, p_tipo : TipoEstado, p_carta_oid : OID -> Carta) : Void;
            public readOID::ReadOID (p_oid : OID -> Estado) : Object->Estado;
            public readAll::ReadAll () : List<Object->Estado>;

            public activar::Custom (p_oid : OID -> Estado) : Void;
        }
    };

    Class Habilidad
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private tipo : TipoHabilidad (1, 1);
            private cantidad : Integer (1, 1);
            private objetivo : Objetivo (1, 1);
        }
        
        operations
        {
            public new::New (p_tipo : TipoHabilidad, p_cantidad : Integer, p_objetivo : Objetivo, p_estado_oid : OID -> Estado) : Object->Habilidad;
            public destroy::Destroy (p_oid : OID -> Habilidad) : Void;
            public modify::Modifier (p_oid : OID -> Habilidad, p_tipo : TipoHabilidad, p_cantidad : Integer, p_objetivo : Objetivo, p_estado_oid : OID -> Estado) : Void;
            public readOID::ReadOID (p_oid : OID -> Habilidad) : Object->Habilidad;
            public readAll::ReadAll () : List<Object->Habilidad>;

            public activar::Custom (p_oid : OID -> Habilidad) : Void;
        }
    };

    Class Partida
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private estado : EstadoPartida (1, 1);
        }
        
        operations
        {
            public new::New (p_estado : EstadoPartida, p_usuario1_oid : OID -> Usuario, p_usuario2_oid : OID -> Usuario, p_mazo1_oid : OID -> Mazo, p_mazo2_oid : OID -> Mazo) : Object->Partida;
            public destroy::Destroy (p_oid : OID -> Partida) : Void;
            public modify::Modifier (p_oid : OID -> Partida, p_estado : EstadoPartida, p_usuario1_oid : OID -> Usuario, p_usuario2_oid : OID -> Usuario, p_mazo1_oid : OID -> Mazo, p_mazo2_oid : OID -> Mazo) : Void;
            public readOID::ReadOID (p_oid : OID -> Partida) : Object->Partida;
            public readAll::ReadAll () : List<Object->Partida>;

            public cambiarEstado::Custom (p_oid : OID -> Partida, p_estado : EstadoPartida) : Void;

        }
    };

    Class JugadorPartida
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private vida : Integer (1, 1);
            private numJugador : Integer (1, 1);
        }
        
        operations
        {
            public new::New (p_vida : Integer, p_numJugador : Integer, p_partida_oid : OID -> Partida) : Object->JugadorPartida;
            public destroy::Destroy (p_oid : OID -> JugadorPartida) : Void;
            public modify::Modifier (p_oid : OID -> JugadorPartida, p_vida : Integer, p_numJugador : Integer, p_partida_oid : OID -> Partida) : Void;
            public readOID::ReadOID (p_oid : OID -> JugadorPartida) : Object->JugadorPartida;
            public readAll::ReadAll () : List<Object->JugadorPartida>;

            public robarCarta::Custom (p_oid : OID -> JugadorPartida) : Void;
            public pasarTurno::Custom (p_oid : OID -> JugadorPartida) : Void;
            public lanzarCarta::Custom (p_oid : OID -> JugadorPartida) : Void;
        }
    };

    Class ZonaPartida
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private tipoZona : TipoZona (1, 1);
        }
        
        operations
        {
            public new::New (p_tipoZona : TipoZona, p_jugador_oid : OID -> JugadorPartida) : Object->ZonaPartida;
            public destroy::Destroy (p_oid : OID -> ZonaPartida) : Void;
            public modify::Modifier (p_oid : OID -> ZonaPartida, p_tipoZona : TipoZona, p_jugador_oid : OID -> JugadorPartida) : Void;
            public readOID::ReadOID (p_oid : OID -> ZonaPartida) : Object->ZonaPartida;
            public readAll::ReadAll () : List<Object->ZonaPartida>;
        }
    };

    Class CartaPartida
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
        }
        
        operations
        {
            public new::New (p_zona_oid : OID -> ZonaPartida, p_original_oid : OID -> Carta, p_accionUsada_oids : List<OID -> Accion>, p_accionReciv_oid : OID -> Accion) : Object->CartaPartida;
            public destroy::Destroy (p_oid : OID -> CartaPartida) : Void;
            public modify::Modifier (p_oid : OID -> CartaPartida, p_zona_oid : OID -> ZonaPartida, p_original_oid : OID -> Carta, p_accionUsada_oids : List<OID -> Accion>, p_accionReciv_oid : OID -> Accion) : Void;
            public readOID::ReadOID (p_oid : OID -> CartaPartida) : Object->CartaPartida;
            public readAll::ReadAll () : List<Object->CartaPartida>;
        }
    };

    Class Turno
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private mana : Integer (1, 1);
        }
        
        operations
        {
            public new::New (p_mana : Integer, p_partida_oid : OID -> Partida, p_jugador_oid : OID -> JugadorPartida) : Object->Turno;
            public destroy::Destroy (p_oid : OID -> Turno) : Void;
            public modify::Modifier (p_oid : OID -> Turno, p_mana : Integer, p_partida_oid : OID -> Partida, p_jugador_oid : OID -> JugadorPartida) : Void;
            public readOID::ReadOID (p_oid : OID -> Turno) : Object->Turno;
            public readAll::ReadAll () : List<Object->Turno>;
        }
    };

    Class Accion
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private name : TipoAccion (1, 1);
        }
        
        operations
        {
            public new::New (p_name : TipoAccion, p_turno_oid : OID -> Turno) : Object->Accion;
            public destroy::Destroy (p_oid : OID -> Accion) : Void;
            public modify::Modifier (p_oid : OID -> Accion, p_name : TipoAccion, p_turno_oid : OID -> Turno) : Void;
            public readOID::ReadOID (p_oid : OID -> Accion) : Object->Accion;
            public readAll::ReadAll () : List<Object->Accion>;
        }
    };

    //Relaciones

    Association UsuarioCarta (Usuario - Carta)
    {
        => navigable cartas : Share (0, *);
        <= navigable usuario (1, 1);
    };

    Association UsuarioMazo (Usuario - Mazo)
    {
        => navigable mazos : Share (0, *);
        <= navigable usuario (1, 1);
    };

    Association MazoCarta (Mazo - Carta)
    {
        => navigable cartas : Share (0, *);
    };

    Association UsuarioPartida1 (Usuario - Partida)
    {
        => navigable partidasLocal (0, *);
        <= navigable usuario1 (1, 1);
    };

    Association UsuarioPartida2 (Usuario - Partida)
    {
        => navigable partidasVisitante (0, *);
        <= navigable usuario2 (1, 1);
    };

    Association MazoPartida1 (Mazo - Partida)
    {
        => navigable partidasLocal (0, *);
        <= navigable mazo1 (1, 1);
    };

    Association MazoPartida2 (Mazo - Partida)
    {
        => navigable partidasVisitante (0, *);
        <= navigable mazo2 (1, 1);
    };

    Association CartaEstado (Carta - Estado)
    {
        => navigable estados : Composite (0, *);
        <= navigable carta (1, 1);
    };
    

    Association EstadoHabilidad (Estado - Habilidad)
    {
        => navigable habilidades : Composite (0, *);
        <= navigable estado (1, 1);
    };
    

    Association PartidaTurno (Partida - Turno)
    {
        => navigable turnos : Composite (0, *);
        <= navigable partida (1, 1);
    };
    
    Association PartidaJugadorPartida (Partida - JugadorPartida)
    {
        => navigable jugadores : Composite (0, *);
        <= navigable partida (1, 1);
    };

    Association JugadorPartidaZonasPartida (JugadorPartida - ZonaPartida)
    {
        => navigable zonas : Composite (0, *);
        <= navigable jugador (1, 1);
    };
    
    Association ZonaPartidaCartaPartida (ZonaPartida - CartaPartida)
    {
        => navigable cartas : Share (0, *);
        <= navigable zona (1, 1);
    };
    
    Association CartaCartaPartida (Carta - CartaPartida)
    {
        => navigable entidades : Share (0, *);
        <= navigable original (1, 1);
    };

    Association JugadorPartidaTurno (JugadorPartida - Turno)
    {
        => navigable turnos : Share (0, *);
        <= navigable jugador (1, 1);
    };

    Association TurnoAccion (Turno - Accion)
    {
        => navigable acciones : Composite (0, *);
        <= navigable turno (1, 1);
    };

    Association AccionCartaPartida_Origen (Accion - CartaPartida)
    {
        => navigable origen : Share (0, 1);
        <= navigable accionUsada (0, *);
    };
    
    Association AccionCartaPartida_Objetivo (Accion - CartaPartida)
    {
        => navigable objetivo : Share (0, *);
        <= navigable accionReciv (0, *);
    };
}
