ConceptualModel CraftCaster {
    
    Enumeration Rareza
    {
        (Comun, 1), (Especial, 2), (Epico, 3), (Legendario, 4)
    };

    Enumeration EstadoCuenta
    {
        (Activa, 1), (Suspendida, 2)
    };

    Enumeration EstadoMazo
    {
        (Incompleto, 1), (Jugable, 2), (Completo, 3), (Deshabilitado, 4)
    };
    
    Enumeration EstadoPartida
    {
        (Espera, 1), (EnCurso, 2), (Finalizada, 3)
    };

    Enumeration TipoZona
    {
        (Mano, 1), (Campo, 2), (Descarte, 3), (Mazo, 4)
    };

    Enumeration TipoUsuario
    {
        (Cliente, 1), (Admin, 2)
    };

    Enumeration TipoCarta
    {
        (Criatura, 1), (Hechizo, 2)
    };

    Enumeration TipoEstado
    {
        (Entrar, 1), (Atacar, 2), (InicioTurno, 3), (FinTurno, 4), (Morir, 5)
    };

    Enumeration TipoHabilidad
    {
        (Ataque, 1), (Danyo, 2), (Cura, 3), (Robar, 4), (Descartar, 5), (Destruir, 6), (Defensa, 7)
    };

    Enumeration TipoAccion
    {
        (Ataque, 1), (Lanzar, 2), (Disparada, 3)
    };

    Enumeration TipoObjetivo
    {
        (Jugador, 1), (Enemigo, 2), (Libre, 3), (TodosEnemigos, 4), (Self, 5) 
    };

    Class Usuario <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private nombreUsuario : String (1, 1);
            private email : String (1, 1);
            private contrasenia : Password (1, 1);

            private fotoPerfil : Byte (1, 1);

            private estadoCuenta : EstadoCuenta (1, 1);
            private tipoUsuario : TipoUsuario (1, 1);
        }
        
        operations
        {
            // CRUD
            public new::New customized (p_nombreUsuario : String, p_email : String, p_contrasenia : Password, p_fotoPerfil : Byte, p_tipoUsuario : TipoUsuario) : Object->Usuario;
            public destroy::Destroy (p_oid : OID -> Usuario) : Void;
            public modify::Modifier (p_oid : OID -> Usuario, p_nombreUsuario : String, p_email : String, p_contrasenia : Password, p_fotoPerfil : Byte, p_estadoCuenta : EstadoCuenta, p_tipoUsuario : TipoUsuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Usuario) : Object->Usuario;
            public readAll::ReadAll () : List<Object->Usuario>;  

            // Login
            public login::Login (p_oid : OID -> Usuario, p_contrasenia : Password) : String;

            // Customs
            public cambiarEstadoCuenta::Custom (p_oid : OID -> Usuario, p_estadoCuenta : EstadoCuenta) : Void;
            public reportarUsuario::Custom (p_oid : OID -> Usuario) : Void;
            
            // Relationer
            public addCarta::Relationer -> UsuarioCarta.cartas (p_oid : OID -> Usuario, p_carta_oids : List<OID -> Carta>) : Void;
            public removeCarta::Unrelationer -> UsuarioCarta.cartas (p_oid : OID -> Usuario, p_carta_oids : List<OID -> Carta>) : Void;
            
            public addMazo::Relationer -> UsuarioMazo.mazos (p_oid : OID -> Usuario, p_mazo_oids : List<OID -> Mazo>) : Void;
            public removeMazo::Unrelationer -> UsuarioMazo.mazos (p_oid : OID -> Usuario, p_mazo_oids : List<OID -> Mazo>) : Void;
            
            public addPartidasLocal::Relationer -> UsuarioPartida1.partidasLocal (p_oid : OID -> Usuario, p_partida_oids : List<OID -> Partida>) : Void;
            public removePartidasLocal::Unrelationer -> UsuarioPartida1.partidasLocal (p_oid : OID -> Usuario, p_partida_oids : List<OID -> Partida>) : Void;

            public addPartidasVisitante::Relationer -> UsuarioPartida2.partidasVisitante (p_oid : OID -> Usuario, p_partida_oids : List<OID -> Partida>) : Void;
            public removePartidasVisitante::Unrelationer -> UsuarioPartida2.partidasVisitante (p_oid : OID -> Usuario, p_partida_oids : List<OID -> Partida>) : Void;

            // En partida
            public obtenerUsuarioLocal::ReadFilter (p_oid : OID -> Partida) : List<Object->Usuario>
            {
                filterLinQ = "entity => entity.PartidasLocal.Any(p => p.Id == p_oid)"
            };

            //Transacciones
            public registrarUsuario::CustomTransaction (p_nombreUsuario : String, p_email : String, p_contrasenia : Password, p_fotoPerfil : Byte) : Object->Usuario;
            public iniciarPartida::CustomTransaction (p_oid : OID -> Usuario) : Void; //Crea una partida con sigo mismo como local y asigna esa partida a su lista de partidas locales
            public unirsePartida::CustomTransaction (p_oid : OID -> Usuario, p_partida_oid : OID -> Partida) : Void;  //Recibe una partida, se une a esta como visitante y la agrega a su lista de partidas visitantes
            public abandonarPartida::CustomTransaction (p_oid : OID -> Usuario) : Void; //Si es local, echa al visitante si existe, elimina la partida de su lista y borra la partida. Si es visitante solo borra la partida de su lista y la variable usuario2 de partida
        }
    };

    Class Mazo
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);

            private nombre : String (1, 1);
            private costeMedio : Float (1, 1);
            private numCartas : Integer (1, 1);
            private estadoMazo : EstadoMazo (1, 1);
            private esPublico : Boolean (1, 1);

            private valoracion : Float (1, 1);
            private imagen : Byte (1, 1);        
        }
        
        operations
        {
            // CRUD
            public newCustomized::New customized (p_nombre : String, p_esPublico : Boolean, p_imagen : Byte, p_usuario_oid : OID -> Usuario) : Object->Mazo;
            public destroy::Destroy (p_oid : OID -> Mazo) : Void;
            public modify::Modifier (p_oid : OID -> Mazo, p_nombre : String, p_costeMedio : Float, p_numCartas : Integer, p_estadoMazo : EstadoMazo, p_esPublico : Boolean, p_valoracion : Float, p_imagen : Byte, p_usuario_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Mazo) : Object->Mazo;
            public readAll::ReadAll () : List<Object->Mazo>;

            // Relationer
            public addLinea::Relationer -> MazoLineaMazo.lineas (p_oid : OID -> Mazo, p_lineaMazo_oids : List<OID -> LineaMazo>) : Void;
            public removeLinea::Unrelationer -> MazoLineaMazo.lineas (p_oid : OID -> Mazo, p_lineaMazo_oids : List<OID -> LineaMazo>) : Void;
        
            // Customs
            public compartir::Custom (p_oid : OID -> Mazo) : Void;
            public calcularEstadisticas::Custom (p_oid : OID -> Mazo) : Void;
            public valorarMazo::Custom (p_oid : OID -> Mazo, p_valoracion : Float) : Void;

            // Buscar Mazos
            public obtenerMazosUsuario::ReadFilter (p_oid : OID -> Usuario) : List<Object->Mazo>
            {
                filterLinQ = "entity => entity.Usuario.Id == p_oid"
            };
            public obtenerMazosPorNombre::ReadFilter (p_nombre : String) : List<Object->Mazo>
            {
                filterLinQ = "entity => entity.Nombre == p_nombre && entity.EsPublico == true"
            };
            public obtenerMazoPorCosteMedio::ReadFilter (p_min_mana : Integer, p_max_mana : Integer) : List<Object->Mazo>
            {
                filterLinQ = "entity => entity.CosteMedio >= p_min_mana && entity.CosteMedio <= p_max_mana && entity.EsPublico == true"
            };
            public obtenerMazoPorValoracion::ReadFilter (p_min_val : Integer, p_max_val : Integer) : List<Object->Mazo>
            {
                filterLinQ = "entity => entity.Valoracion >= p_min_val && entity.Valoracion <= p_max_val && entity.EsPublico == true"
            };
            // En partida
            public obtenerMazoJugador1::ReadFilter (p_oid : OID -> Partida) : List<Object->Mazo>
            {
                filterLinQ = "entity => entity.PartidasLocal.Any(p => p.Id == p_oid)"
            };
            public obtenerMazoJugador2::ReadFilter (p_oid : OID -> Partida) : List<Object->Mazo>
            {
                filterLinQ = "entity => entity.PartidasVisitante.Any(p => p.Id == p_oid)"
            };
        }
    };

    Class LineaMazo
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private cantidad : Integer (1, 1);
        }
        
        operations
        {
            // CRUD
            public new::New (p_cantidad : Integer, p_mazo_oid : OID -> Mazo, p_carta_oid : OID -> Carta) : Object->LineaMazo;
            public destroy::Destroy (p_oid : OID -> LineaMazo) : Void;
            public modify::Modifier (p_oid : OID -> LineaMazo, p_cantidad : Integer, p_mazo_oid : OID -> Mazo, p_carta_oid : OID -> Carta) : Void;
            public readOID::ReadOID (p_oid : OID -> LineaMazo) : Object->LineaMazo;
            public readAll::ReadAll () : List<Object->LineaMazo>;
        }
    };

    Class Carta
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private nombre : String (1, 1);
            private rareza : Rareza (1, 1);
            private costeMana : Integer (1, 1);
            private tipo : TipoCarta (1, 1);
            private vida : Integer (0, 1);
            private ataque : Integer (0, 1);

            private descripcion : String (1, 1);
            private imagen : Byte (1, 1);
            private esPublica : Boolean (1, 1);
        }
        
        operations
        {
            // CRUD
            public new::New customized (p_nombre : String, p_rareza : Rareza, p_costeMana : Integer, p_tipo : TipoCarta, p_descripcion : String, p_imagen : Byte, p_esPublica : Boolean, p_ataque : Integer, p_vida : Integer, p_usuario_oid : OID -> Usuario) : Object->Carta;
            public destroy::Destroy (p_oid : OID -> Carta) : Void;
            public modify::Modifier (p_oid : OID -> Carta, p_nombre : String, p_rareza : Rareza, p_costeMana : Integer, p_tipo : TipoCarta, p_descripcion : String, p_imagen : Byte, p_esPublica : Boolean, p_usuario_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Carta) : Object->Carta;
            public readAll::ReadAll () : List<Object->Carta>;

            // Customs
            public compartir::Custom (p_oid : OID -> Carta) : Void;

            // LinQ
            public obtenerCartasUsuario::ReadFilter (p_oid : OID -> Usuario) : List<Object->Carta>
            {
                filterLinQ = "entity => entity.Usuario.Id == p_oid"
            };
            public obtenerCartaPorNombre::ReadFilter (p_nombre : String) : List<Object->Carta>
            {
                filterLinQ = "entity => entity.Nombre == p_nombre && entity.EsPublica == true"
            };
            public obtenerCartaPorCosteMana::ReadFilter (p_mana : Integer) : List<Object->Carta>
            {
                filterLinQ = "entity => entity.CosteMana == p_mana && entity.EsPublica == true"
            };
            public obtenerCartaPorRareza::ReadFilter (p_rareza : Rareza) : List<Object->Carta>
            {
                filterLinQ = "entity => entity.Rareza == p_rareza && entity.EsPublica == true"
            };
            public obtenerCartaPorTipo::ReadFilter (p_tipo : TipoCarta) : List<Object->Carta>
            {
                filterLinQ = "entity => entity.Tipo == p_tipo && entity.EsPublica == true"
            };
        }
    };

    Class Estado
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private tipo : TipoEstado (1, 1);
        }
        
        operations
        {   
            // CRUD
            public new::New (p_tipo : TipoEstado, p_carta_oid : OID -> Carta) : Object->Estado;
            public destroy::Destroy (p_oid : OID -> Estado) : Void;
            public modify::Modifier (p_oid : OID -> Estado, p_tipo : TipoEstado, p_carta_oid : OID -> Carta) : Void;
            public readOID::ReadOID (p_oid : OID -> Estado) : Object->Estado;
            public readAll::ReadAll () : List<Object->Estado>;

            // Relationer
            public addHabilidade::Relationer -> EstadoHabilidad.habilidades (p_oid : OID -> Estado, p_habilidad_oids : List<OID -> Habilidad>) : Void;
            public removeHabilidade::Unrelationer -> EstadoHabilidad.habilidades (p_oid : OID -> Estado, p_habilidad_oids : List<OID -> Habilidad>) : Void;
            
            // Customs
            public activar::Custom (p_oid : OID -> Estado) : Void;
        }
    };

    Class Habilidad
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private tipo : TipoHabilidad (1, 1);
            private cantidad : Integer (1, 1);
            private tipoObjetivo : TipoObjetivo (1, 1);
            private objetivo : Integer (1, 1);
        }
        
        operations
        {
            // CRUD
            public new::New (p_tipo : TipoHabilidad, p_cantidad : Integer, p_tipoObjetivo : TipoObjetivo, p_objetivo : Integer, p_estado_oid : OID -> Estado) : Object->Habilidad;
            public destroy::Destroy (p_oid : OID -> Habilidad) : Void;
            public modify::Modifier (p_oid : OID -> Habilidad, p_tipo : TipoHabilidad, p_cantidad : Integer, p_tipoObjetivo : TipoObjetivo, p_objetivo : Integer, p_estado_oid : OID -> Estado) : Void;
            public readOID::ReadOID (p_oid : OID -> Habilidad) : Object->Habilidad;
            public readAll::ReadAll () : List<Object->Habilidad>;

            // Transacciones
            public activar::CustomTransaction (p_oid : OID -> Habilidad, p_partida_oid : OID -> Partida) : Void; //Comprueba el tipo de habilidad y la ejecuta
        }
    };

    Class Partida
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private estado : EstadoPartida (1, 1);
            private ganador : Integer (0, 1);
            private fechaInicio : Date (1, 1);

        }
        
        operations
        {   
            // CRUD
            public new::New (p_estado : EstadoPartida, p_fechaInicio : Date, p_usuario1_oid : OID -> Usuario, p_mazo1_oid : OID -> Mazo) : Object->Partida;
            public destroy::Destroy (p_oid : OID -> Partida) : Void;
            public modify::Modifier (p_oid : OID -> Partida, p_estado : EstadoPartida, p_fechaInicio : Date, p_usuario1_oid : OID -> Usuario, p_mazo1_oid : OID -> Mazo) : Void;
            public readOID::ReadOID (p_oid : OID -> Partida) : Object->Partida;
            public readAll::ReadAll () : List<Object->Partida>;

            // Customs
            public cambiarEstado::Custom (p_oid : OID -> Partida, p_estado : EstadoPartida) : Void;
            public getActivo::Custom (p_oid : OID -> Partida) : Integer;
            public getCarta::Custom (p_oid : OID -> Partida, jugador : Integer, zona : Integer, carta : Integer) : Integer;
            public getPlayer::Custom (p_oid : OID -> Partida, index : Integer) : Integer;

            //Trannsacciones
            public finalizar::CustomTransaction (p_oid : OID -> Partida) : Void; //Establece la partida como finalizada y define al ganador
            public pasarTurno::CustomTransaction (p_oid : OID -> Partida) : Void; //Llama a final turno del jugador activo e inicio del otro y crea un turno nuevo en su lista de turnos.

            // Relationer
            public addTurno::Relationer -> PartidaTurno.turnos (p_oid : OID -> Partida, p_turno_oids : List<OID -> Turno>) : Void;
            public removeTurno::Unrelationer -> PartidaTurno.turnos (p_oid : OID -> Partida, p_turno_oids : List<OID -> Turno>) : Void;

            public addJugadores::Relationer -> PartidaJugadorPartida.jugadores (p_oid : OID -> Partida, p_jugadorPartida_oids : List<OID -> JugadorPartida>) : Void;
            public removeJugadores::Unrelationer -> PartidaJugadorPartida.jugadores (p_oid : OID -> Partida, p_jugadorPartida_oids : List<OID -> JugadorPartida>) : Void;
            
            public addUsuario2::Relationer -> UsuarioPartida2.usuario2 (p_oid : OID -> Partida, p_usuario_oid : OID -> Usuario) : Void;
            public removeUsuario2::Unrelationer -> UsuarioPartida2.usuario2 (p_oid : OID -> Partida, p_usuario_oid : OID -> Usuario) : Void;

            public addMazo2::Relationer -> MazoPartida2.mazo2 (p_oid : OID -> Partida, p_mazo_oid : OID -> Mazo) : Void;
            public removeMazo2::Unrelationer -> MazoPartida2.mazo2 (p_oid : OID -> Partida, p_mazo_oid : OID -> Mazo) : Void;

            // LinQ
            public obtenerPartidasUsuario::ReadFilter (p_oid : OID -> Usuario) : List<Object->Partida>
            {
                filterLinQ = "entity => entity.Usuario1.Id == p_oid || entity.Usuario2.Id == p_oid"
            };
        }
    };

    Class JugadorPartida
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private vida : Integer (1, 1);
            private numJugador : Integer (1, 1);
            private mana : Integer (1, 1);
            private activo : Boolean (1, 1);
        }
        
        operations
        {
            // CRUD
            public new::New (p_vida : Integer, p_numJugador : Integer, p_mana : Integer, p_activo : Boolean, p_partida_oid : OID -> Partida) : Object->JugadorPartida;
            public destroy::Destroy (p_oid : OID -> JugadorPartida) : Void;
            public modify::Modifier (p_oid : OID -> JugadorPartida, p_vida : Integer, p_numJugador : Integer, p_mana : Integer, p_activo : Boolean, p_partida_oid : OID -> Partida) : Void;
            public readOID::ReadOID (p_oid : OID -> JugadorPartida) : Object->JugadorPartida;
            public readAll::ReadAll () : List<Object->JugadorPartida>;

            // Customs
            public actualizarVida::Custom (p_oid : OID -> JugadorPartida, p_vida : Integer) : Void;
            public actualizarMana::Custom (p_oid : OID -> JugadorPartida, p_mana : Integer) : Void;

            // Relationer
            public addZona::Relationer -> JugadorPartidaZonasPartida.zonas (p_oid : OID -> JugadorPartida, p_zonaPartida_oids : List<OID -> ZonaPartida>) : Void;
            public removeZona::Unrelationer -> JugadorPartidaZonasPartida.zonas (p_oid : OID -> JugadorPartida, p_zonaPartida_oids : List<OID -> ZonaPartida>) : Void;
            
            //Transacciones
            public lanzarCarta::CustomTransaction (p_oid : OID -> JugadorPartida, p_carta_oid : OID -> CartaPartida) : Void; //Comprueba y consume el mana, cambia la carta de zona y activa sus habilidades de entrada
            public robarCarta::CustomTransaction (p_oid : OID -> JugadorPartida) : Void; //Igual que lanzar pero de mazo a mano (toma la primera del mazo)
            public inicioTurno::CustomTransaction (p_oid : OID -> JugadorPartida) : Void; //Establece activo true, regenera el mana, establece puedeAtacar en true para las criaturas y activa habilidades de inicio de turno
            public finalTurno::CustomTransaction (p_oid : OID -> JugadorPartida) : Void; //Establece activo falso y activa habilidades de fin de turno
        }
    };

