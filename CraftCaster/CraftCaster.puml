@startuml CraftCaster
skinparam packageStyle rectangle
title CraftCaster Domain

package "CraftCaster" {
  enum Rareza {
    Comun
    Especial
    Epico
    Legendario
  }

  enum EstadoCuenta {
    Activa
    Suspendida
  }

  enum EstadoMazo {
    Incompleto
    Jugable
    Completo
    Deshabilitado
  }

  enum EstadoPartida {
    Espera
    EnCurso
    Finalizada
  }

  enum TipoZona {
    Mano
    Campo
    Descarte
    Mazo
  }

  enum TipoUsuario {
    Cliente
    Admin
  }

  enum TipoCarta {
    Criatura
    Hechizo
  }

  enum TipoEstado {
    Entrar
    Atacar
    InicioTurno
    FinTurno
    Morir
  }

  enum TipoHabilidad {
    Elem1
    Elem2
  }

  enum TipoAccion {
    Ataque
    Lanzar
    Disparada
  }

  enum Objetivo {
    Jugador
    Enemigo
    Libre
    TodosEnemigos
    Self
  }

  class Usuario <<User>> {
    -id: long <<oid>> <<isToken>>
    -nombreUsuario: string
    -email: string
    -contrasenia: string <<password>>
    -fotoPerfil: byte
    -nivel: int
    -exp: int
  }

  class Mazo {
    -id: long <<oid>>
    -nombre: string
    -costeMedio: float
    -numCartas: int
    -estadoMazo: EstadoMazo
    -esPublico: bool
    -valoracion: float
    -imagen: byte
    -creador: string
  }

  class Carta {
    -id: long <<oid>>
    -nombre: string
    -rareza: Rareza
    -costeMana: int
    -tipo: TipoCarta
    -vida: int?
    -ataque: int?
    -descripcion: string
    -imagen: byte
    -esPublica: bool
  }

  class Estado {
    -id: long <<oid>>
    -tipo: TipoEstado
  }

  class Habilidad {
    -id: long <<oid>>
    -tipo: TipoHabilidad
    -cantidad: int
    -objetivo: Objetivo
  }

  class Partida {
    -id: long <<oid>>
    -estado: EstadoPartida
  }

  class JugadorPartida {
    -id: long <<oid>>
    -vida: int
    -numJugador: int
  }

  class ZonaPartida {
    -id: long <<oid>>
    -tipoZona: TipoZona
  }

  class CartaPartida {
    -id: long <<oid>>
  }

  class Turno {
    -id: long <<oid>>
    -mana: int
  }

  class Accion {
    -id: long <<oid>>
    -name: TipoAccion
  }

  ' Relationships
  Usuario "Usuario\n1" o-- "Cartas\n0..*" Carta
  Usuario "Usuario\n1" o-- "Mazos\n0..*" Mazo
  Mazo "Mazo\n1" o-- "Cartas\n0..*" Carta
  Usuario "Usuario1\n1" -- "PartidasLocal\n0..*" Partida
  Usuario "Usuario2\n1" -- "PartidasVisitante\n0..*" Partida
  Mazo "Mazo1\n1" -- "PartidasLocal\n0..*" Partida
  Mazo "Mazo2\n1" -- "PartidasVisitante\n0..*" Partida
  Carta "Carta\n1" *-- "Estados\n0..*" Estado
  Estado "Estado\n1" o-- "Habilidades\n0..*" Habilidad
  Partida "Partida\n1" *-- "Turnos\n0..*" Turno
  Partida "Partida\n1" -- "Jugadores\n0..*" JugadorPartida
  JugadorPartida "Jugador\n1" *-- "Zonas\n0..*" ZonaPartida
  ZonaPartida "Zona\n1" *-- "Cartas\n0..*" CartaPartida
  Carta "Original\n1" *-- "Entidades\n0..*" CartaPartida
  JugadorPartida "Jugador\n1" o-- "Turnos\n0..*" Turno
  Turno "Turno\n1" *-- "Acciones\n0..*" Accion
  Accion "AccionUsada\n1..*" o-- "Origen\n0..*" CartaPartida
  Accion "AccionReciv\n1" o-- "Objetivo\n0..*" CartaPartida
}
@enduml
