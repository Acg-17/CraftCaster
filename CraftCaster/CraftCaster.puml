@startuml CraftCaster
skinparam packageStyle rectangle
title CraftCaster Domain

package "CraftCaster" {
  enum Rareza {
    Comun
    Especial
    Epico
    Legendario
  }

  enum EstadoMazo {
    Incompleto
    Jugable
    Completo
  }

  class Usuario <<User>> {
    -id: long <<oid>> <<isToken>>
    -nombreUsuario: string
    -email: string
    -contrasenia: string <<password>>
    -fotoPerfil: byte
    -nivel: int
    -exp: int
  }

  class Mazo {
    -id: long <<oid>>
    -nombre: string
    -costeMedio: float
    -numCartas: int
    -estadoMazo: EstadoMazo
    -valoracion: float
    -imagen: byte
    -creador: string
  }

  class Carta {
    -id: long <<oid>>
    -nombre: string
    -rareza: Rareza
    -mana: int
    -descripcion: string
    -imagen: byte
  }

  class Estado {
    -id: long <<oid>>
  }

  class Habilidad {
    -id: long <<oid>>
  }

  class Partida {
    -id: long <<oid>>
  }

  class Turno {
    -id: long <<oid>>
  }

  ' Relationships
  Usuario "Usuario\n1" o-- "Cartas\n0..*" Carta
  Usuario "Usuario\n1" o-- "Mazos\n0..*" Mazo
  Mazo "Mazo\n1" o-- "Cartas\n0..*" Carta
  Usuario "Usuario1\n1" -- "PartidasLocal\n0..*" Partida
  Usuario "Usuario2\n1" -- "PartidasVisitante\n0..*" Partida
  Mazo "Mazo1\n1" -- "PartidasLocal\n0..*" Partida
  Mazo "Mazo2\n1" -- "PartidasVisitante\n0..*" Partida
  Carta "Carta\n1" *-- "Estados\n0..*" Estado
  Estado "Estado\n1" o-- "Habilidades\n0..*" Habilidad
  Partida "Partida\n1" *-- "Turnos\n0..*" Turno
}
@enduml
