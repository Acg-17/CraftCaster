@model CraftCaster.Web.ViewModels.CreadorCartaViewModel
@using CraftCaster.Domain.Enums
@using System.Text.Json
@{
    bool esEdicion = Model.Id > 0;
    ViewData["Title"] = esEdicion ? $"Editar: {Model.Nombre}" : "Creador de cartas";
    var bloquesInicialesJson = JsonSerializer.Serialize(
        (Model.Bloques ?? new()).Select(b => new
        {
            tipoEstado = (int)b.TipoEstado,
            tipoHabilidad = (int)b.TipoHabilidad,
            cantidad = b.Cantidad,
            tipoObjetivo = (int)b.TipoObjetivo,
            objetivo = b.Objetivo
        }));
    var descripcionInicialJson = JsonSerializer.Serialize(Model.Descripcion ?? string.Empty);
}

<link rel="stylesheet" href="~/css/wireframe-cartas.css" asp-append-version="true" />

<form asp-action="@(esEdicion ? "Editar" : "Crear")" asp-route-id="@(esEdicion ? Model.Id : (int?)null)" method="post" enctype="multipart/form-data" id="formCreador">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    @if (ViewBag.PlantillaId is int plantillaId)
    {
        <input type="hidden" name="plantillaId" value="@plantillaId" />
    }

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                <div>
                    <h1 class="h3 mb-1">@(esEdicion ? "Editar carta" : "Creador de cartas")</h1>
                    <p class="text-body-secondary mb-0">Monta tu Criatura (máx. 2 habilidades) o Hechizo (máx. 3 efectos) y añade descripciones personalizadas.</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-bg-light border px-3 py-2" id="badgeBalance">Equilibrada (0/10 maná)</span>
                    <a class="btn btn-outline-dark" asp-action="Index">Mis cartas</a>
                    <button type="submit" class="btn btn-primary" id="btnGuardar">@(esEdicion ? "Guardar cambios" : "Guardar carta")</button>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>
            <div class="alert alert-danger py-2 mb-3 d-none" id="alertaRota" role="alert">
                Esta carta supera el límite de 10 de maná y está demasiado rota. Reduce ataque, vida o habilidades para equilibrarla.
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label asp-for="Nombre" class="form-label small fw-semibold">Nombre</label>
                    <input asp-for="Nombre" class="form-control" id="inpNombre" placeholder="Ej. Gato Pescador" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-6 col-md-3">
                    <label asp-for="Rareza" class="form-label small fw-semibold">Rareza</label>
                    <select asp-for="Rareza" class="form-select" id="inpRareza">
                        <option value="@((int)Rareza.Comun)">Común (+0 maná)</option>
                        <option value="@((int)Rareza.Especial)">Especial (+0 maná)</option>
                        <option value="@((int)Rareza.Epico)">Épico (-1 maná)</option>
                        <option value="@((int)Rareza.Legendario)">Legendario (-4 maná)</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label asp-for="CosteMana" class="form-label small fw-semibold">Coste de maná</label>
                    <input asp-for="CosteMana" type="number" readonly class="form-control bg-body-tertiary fw-semibold text-center" id="inpMana" />
                </div>
                <div class="col-12 col-md-3">
                    <label asp-for="ImagenArchivo" class="form-label small fw-semibold">Ilustración (opcional)</label>
                    <input asp-for="ImagenArchivo" type="file" accept="image/*" class="form-control" id="inpImagen" />
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" asp-for="Tipo" id="hidTipo" />
    <input type="hidden" asp-for="Ataque" id="hidAtaque" />
    <input type="hidden" asp-for="Vida" id="hidVida" />
    <input type="hidden" asp-for="Descripcion" id="hidDescripcion" />
    <div id="hiddenBloques"></div>

    <div class="row g-3">
        <!-- Columna 1: Bloques disponibles -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h2 class="h6 fw-semibold mb-3">Bloques disponibles</h2>

                    <div class="small text-uppercase text-body-secondary fw-semibold mb-2">Tipo de carta</div>
                    <div class="d-flex flex-column gap-2 mb-4">
                        <div class="scratch-block block-palette" draggable="true" data-kind="tipo" data-value="1">
                            <span>Criatura</span>
                            <span class="small text-body-secondary ms-auto">En mesa · Máx. 2 hab.</span>
                        </div>
                        <div class="scratch-block block-palette" draggable="true" data-kind="tipo" data-value="2">
                            <span>Hechizo</span>
                            <span class="small text-body-secondary ms-auto">Al instante · Máx. 3 ef.</span>
                        </div>
                    </div>

                    <div class="small text-uppercase text-body-secondary fw-semibold mb-2">Habilidades</div>
                    <div class="d-flex flex-column gap-2 mb-4">
                        <div class="scratch-block block-palette" draggable="true" data-kind="efecto" data-value="2">Daño instantáneo</div>
                        <div class="scratch-block block-palette" draggable="true" data-kind="efecto" data-value="3">Sumar vida</div>
                        <div class="scratch-block block-palette" draggable="true" data-kind="efecto" data-value="4">Robar carta</div>
                        <div class="scratch-block block-palette" draggable="true" data-kind="efecto" data-value="5">Descartar mano rival</div>
                        <div class="scratch-block block-palette" draggable="true" data-kind="efecto" data-value="6">Descartar carta objetivo</div>
                        <div class="scratch-block block-palette" id="paletaDefensa" draggable="true" data-kind="efecto" data-value="7">
                            <span>Daño al defender</span>
                            <span class="small text-body-secondary ms-auto">Solo criatura</span>
                        </div>
                    </div>

                    <div class="small text-uppercase text-body-secondary fw-semibold mb-2">Descripción personalizada</div>
                    <div class="d-flex flex-column gap-2">
                        <div class="scratch-block block-palette" id="paletaDescCorta" draggable="true" data-kind="desc" data-value="1">
                            <span>Descripción corta</span>
                            <span class="small text-body-secondary ms-auto">1 línea · 30 car.</span>
                        </div>
                        <div class="scratch-block block-palette" id="paletaDescLarga" draggable="true" data-kind="desc" data-value="2">
                            <span>Descripción larga</span>
                            <span class="small text-body-secondary ms-auto">2 líneas · 60 car.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna 2: Ensamblador de logica (Scratch) -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h2 class="h6 fw-semibold mb-0">Ensamblador de lógica</h2>
                            <span class="badge text-bg-light border" id="contadorHabilidades">0 / 2 hab.</span>
                            <span class="badge text-bg-light border" id="contadorDesc">0 / 2 lín. texto</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLimpiar">Limpiar</button>
                    </div>

                    <div class="small text-danger mb-2 d-none" id="avisoLimite"></div>

                    <div class="scratch-dropzone flex-grow-1" id="dropzone">
                        <div class="scratch-stack" id="pilaScratch"></div>
                    </div>

                    <div class="d-flex justify-content-end align-items-center mt-3 pt-2">
                        <span class="small text-body-secondary">Arrastra los bloques para reordenarlos</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna 3: Vista previa (proporcion TCG fija 5:7) -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3 d-flex flex-column align-items-center">
                    <h2 class="h6 fw-semibold text-center mb-2">Vista previa</h2>

                    <div class="cc-card" id="cartaPreview">
                        <div class="cc-card-top-left-group" id="prevIconsLeft"></div>

                        <div class="cc-card-top-center" id="prevCenterSlot" title="Haz clic para alternar Maná / Vida">
                            <div class="cc-mana-circle" id="prevManaBadge">1</div>
                            <div class="cc-heart-wrap d-none" id="prevHeartBadge">
                                <svg viewBox="0 0 40 38" width="42" height="40" fill="#ffffff" stroke="#212529" stroke-width="2">
                                    <path d="M20 35 C20 35 4 24 4 13 C4 7 8.5 3 13.5 3 C16.8 3 19 4.8 20 7 C21 4.8 23.2 3 26.5 3 C31.5 3 36 7 36 13 C36 24 20 35 20 35 Z" />
                                </svg>
                                <span class="cc-heart-num" id="prevVidaNum">1</span>
                            </div>
                        </div>

                        <div class="cc-card-top-right d-none" id="prevIconRight" title="Ataque / 3.º efecto"></div>

                        <div class="cc-art-box mt-2">
                            <span class="cc-art-label @(string.IsNullOrEmpty(Model.ImagenUrlActual) ? "" : "d-none")" id="prevArtLabel">Ilustración</span>
                            <img id="prevImagen" src="@(Model.ImagenUrlActual ?? "")" alt="Vista previa" class="@(string.IsNullOrEmpty(Model.ImagenUrlActual) ? "d-none" : "")" />
                        </div>

                        <div class="cc-rarity-divider" id="prevRarezaText">COMÚN</div>

                        <div class="fw-semibold text-center small mb-1 text-truncate" id="prevNombre">@(string.IsNullOrWhiteSpace(Model.Nombre) ? "Nombre de la carta" : Model.Nombre)</div>
                        <div class="cc-card-desc text-body-secondary text-center" id="prevDescripcion"></div>
                    </div>

                    <p class="small text-body-secondary text-center mt-3 mb-0" id="notaAlternancia"></p>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            function iconoSvg(id, size) {
                const s = size || 18;
                switch (id) {
                    case 1: return `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="#212529" stroke-width="2"><path d="M14.5 3.5L20.5 3.5L20.5 9.5L10 20L4 14L14.5 3.5Z"/><line x1="3" y1="21" x2="7" y2="17"/><line x1="6" y1="12" x2="12" y2="18"/></svg>`;
                    case 2: return `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="#212529" stroke-width="2"><polygon points="13 2 4 14 11 14 10 22 20 10 13 10 13 2"/></svg>`;
                    case 3: return `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="#212529" stroke-width="2"><path d="M12 20 C12 20 4 14 4 8.5 C4 5.5 6.5 3.5 9 3.5 C10.6 3.5 11.6 4.4 12 5.5 C12.4 4.4 13.4 3.5 15 3.5 C17.5 3.5 20 5.5 20 8.5 C20 14 12 20 12 20 Z"/><line x1="12" y1="8.5" x2="12" y2="14.5"/><line x1="9" y1="11.5" x2="15" y2="11.5"/></svg>`;
                    case 4: return `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="#212529" stroke-width="2"><rect x="7" y="4" width="12" height="16" rx="1.5"/><line x1="4" y1="12" x2="10" y2="12"/><line x1="7" y1="9" x2="7" y2="15"/></svg>`;
                    case 5: return `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="#212529" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M6 6L7 20H17L18 6"/><line x1="10" y1="10" x2="10" y2="16"/><line x1="14" y1="10" x2="14" y2="16"/></svg>`;
                    case 6: return `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="#212529" stroke-width="2"><circle cx="12" cy="9" r="5"/><circle cx="10" cy="8.5" r="0.8" fill="#212529"/><circle cx="14" cy="8.5" r="0.8" fill="#212529"/><line x1="5" y1="19" x2="19" y2="15"/><line x1="5" y1="15" x2="19" y2="19"/></svg>`;
                    case 7: return `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="#212529" stroke-width="2"><path d="M12 3L4 6V12C4 16.5 7.5 19.5 12 21C16.5 19.5 20 16.5 20 12V6L12 3Z"/></svg>`;
                    default: return '';
                }
            }

            function escaparHtml(str) {
                return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            const EVENTOS = {
                1: 'Al entrar',
                2: 'Al atacar',
                3: 'Al iniciar turno',
                4: 'Al finalizar turno',
                5: 'Al morir'
            };

            const EFECTOS = {
                2: { nombre: 'Daño instantáneo', costeUnit: 1.0, objetivosCriatura: [2, 1, 4], objetivosHechizo: [2, 1, 4], cantidadFija: null, cuandoFijo: null },
                3: { nombre: 'Sumar vida', costeUnit: 0.6, objetivosCriatura: [1, 5], objetivosHechizo: [1], cantidadFija: null, cuandoFijo: null },
                4: { nombre: 'Robar carta', costeUnit: 1.4, objetivosCriatura: [1], objetivosHechizo: [1], cantidadFija: null, cuandoFijo: null },
                5: { nombre: 'Descartar mano rival', costeUnit: 2.0, objetivosCriatura: [2], objetivosHechizo: [2], cantidadFija: null, cuandoFijo: null },
                6: { nombre: 'Descartar carta objetivo', costeUnit: 3.5, objetivosCriatura: [2, 1], objetivosHechizo: [2, 1], cantidadFija: 1, cuandoFijo: null },
                7: { nombre: 'Daño al defender', costeUnit: 0.9, objetivosCriatura: [2], objetivosHechizo: [2], cantidadFija: null, cuandoFijo: 'Al recibir daño' }
            };

            const OBJETIVOS = {
                1: 'Jugador',
                2: 'Enemigo',
                4: 'Todos los enemigos',
                5: 'Sí mismo'
            };

            const RAREZAS = {
                1: { etiqueta: 'COMÚN', descuento: 0 },
                2: { etiqueta: 'ESPECIAL', descuento: 0 },
                3: { etiqueta: 'ÉPICO', descuento: -1 },
                4: { etiqueta: 'LEGENDARIO', descuento: -4 }
            };

            // Hidratar items (habilidades + descripciones personalizadas intercaladas)
            const bloquesIniciales = @Html.Raw(bloquesInicialesJson);
            const descInicial = @Html.Raw(descripcionInicialJson);
            const itemsIniciales = [];
            const habsValidas = bloquesIniciales.filter(b => EFECTOS[b.tipoHabilidad]);
            let habCursor = 0;

            if (descInicial && descInicial.includes('"')) {
                const lineasGuardadas = descInicial.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
                lineasGuardadas.forEach(linea => {
                    if (linea.startsWith('"') && linea.endsWith('"') && linea.length >= 2) {
                        const texto = linea.slice(1, -1);
                        itemsIniciales.push({ kind: 'desc', lineas: texto.length > 30 ? 2 : 1, texto });
                    } else if (!linea.startsWith('Criatura ') && !linea.startsWith('Hechizo') && habCursor < habsValidas.length) {
                        itemsIniciales.push({ kind: 'hab', ...habsValidas[habCursor++] });
                    }
                });
            }
            while (habCursor < habsValidas.length) {
                itemsIniciales.push({ kind: 'hab', ...habsValidas[habCursor++] });
            }

            let estado = {
                tipo: @((int)Model.Tipo),
                ataque: @(Model.Ataque > 0 ? Model.Ataque : 1),
                vida: @(Model.Vida > 0 ? Model.Vida : 1),
                items: itemsIniciales
            };

            let mostrandoVida = false;

            const pila = document.getElementById('pilaScratch');
            const dropzone = document.getElementById('dropzone');
            const inpNombre = document.getElementById('inpNombre');
            const inpRareza = document.getElementById('inpRareza');
            const inpMana = document.getElementById('inpMana');
            const inpImagen = document.getElementById('inpImagen');
            const avisoLimite = document.getElementById('avisoLimite');

            function obtenerHabilidades() {
                return estado.items.filter(x => x.kind === 'hab');
            }

            function maxHabilidadesActual() {
                return estado.tipo === 1 ? 2 : 3;
            }

            function maxLineasDescActual() {
                const numHabs = obtenerHabilidades().length;
                return Math.max(0, 4 - numHabs); // 4 líneas en total: 0 hab -> 4, 1 hab -> 3, 2 hab -> 2, 3 hab -> 1
            }

            function partirEnLineas(texto, maxPorLinea, maxLineas) {
                const limpio = (texto || '').trim();
                if (!limpio) return [];
                const resultado = [];
                let restante = limpio;

                while (restante.length > 0 && resultado.length < maxLineas) {
                    if (restante.length <= maxPorLinea) {
                        resultado.push(restante);
                        break;
                    }
                    if (resultado.length === maxLineas - 1) {
                        resultado.push(restante.slice(0, maxPorLinea).trimEnd());
                        break;
                    }
                    // Buscar el último espacio hasta el carácter maxPorLinea (30)
                    const corte = restante.lastIndexOf(' ', maxPorLinea);
                    if (corte > 0) {
                        resultado.push(restante.slice(0, corte).trimEnd());
                        restante = restante.slice(corte + 1).trimStart();
                    } else {
                        // Palabra larga sin espacios: partir exactamente en el carácter 30
                        resultado.push(restante.slice(0, maxPorLinea));
                        restante = restante.slice(maxPorLinea);
                    }
                }
                return resultado;
            }

            function lineasDescUsadas() {
                return estado.items.filter(x => x.kind === 'desc').reduce((acc, d) => acc + d.lineas, 0);
            }

            function objetivosPermitidos(tipoHabilidad) {
                const ef = EFECTOS[tipoHabilidad] || EFECTOS[2];
                return estado.tipo === 1 ? ef.objetivosCriatura : ef.objetivosHechizo;
            }

            function calcularMana() {
                let total = 0;
                const habs = obtenerHabilidades();

                if (estado.tipo === 1) {
                    total += (Math.max(1, estado.ataque) * 0.6) + (Math.max(1, estado.vida) * 0.5);
                }

                habs.forEach(b => {
                    const ef = EFECTOS[b.tipoHabilidad] || EFECTOS[2];
                    const repetible = estado.tipo === 1 && !ef.cuandoFijo && (b.tipoEstado === 2 || b.tipoEstado === 3 || b.tipoEstado === 4);

                    let multCuando = 1.0;
                    if (repetible) {
                        if (b.tipoHabilidad === 6) multCuando = 2.5;
                        else if (b.tipoHabilidad === 5) multCuando = 2.0;
                        else multCuando = 1.8;
                    }

                    const multObj = (b.tipoHabilidad === 2 && b.tipoObjetivo === 4) ? 2.5 : 1.0;
                    const cant = ef.cantidadFija ?? Math.max(1, b.cantidad);
                    total += ef.costeUnit * cant * multCuando * multObj;
                });

                if (habs.length === 2) total += 0.5;
                else if (habs.length >= 3) total += 1.5;

                const rar = RAREZAS[parseInt(inpRareza.value, 10)] || RAREZAS[1];
                total += rar.descuento;

                return Math.max(0, Math.round(total));
            }

            function generarTextoPlano() {
                const lineas = [];
                if (estado.tipo === 1) {
                    lineas.push(`Criatura ${estado.ataque}/${estado.vida}.`);
                } else {
                    lineas.push('Hechizo. Al entrar:');
                }

                estado.items.forEach(item => {
                    if (item.kind === 'desc') {
                        const limpio = (item.texto || '').replace(/"/g, '').trim();
                        if (limpio) lineas.push(`"${limpio}"`);
                    } else {
                        const ef = EFECTOS[item.tipoHabilidad] || EFECTOS[2];
                        const cuando = estado.tipo === 1
                            ? (ef.cuandoFijo || EVENTOS[item.tipoEstado] || 'Al entrar') + ': '
                            : '';
                        if (item.tipoHabilidad === 4) lineas.push(`${cuando}Robar ${item.cantidad} carta(s).`);
                        else if (item.tipoHabilidad === 5) lineas.push(`${cuando}Rival descarta ${item.cantidad} carta(s).`);
                        else if (item.tipoHabilidad === 6) lineas.push(`${cuando}Descartar 1 carta (${OBJETIVOS[item.tipoObjetivo] || 'Enemigo'}).`);
                        else if (item.tipoHabilidad === 7) lineas.push(`${cuando}Devuelve ${item.cantidad} de daño al atacante.`);
                        else lineas.push(`${cuando}${ef.nombre} ${item.cantidad} a ${OBJETIVOS[item.tipoObjetivo] || 'Enemigo'}.`);
                    }
                });
                return lineas.join('\n');
            }

            function generarHtmlPreview() {
                const lineas = [];
                if (estado.tipo === 1) {
                    lineas.push(`<div class="cc-line text-dark"><span>Criatura</span><strong>${estado.ataque}/${estado.vida}</strong></div>`);
                } else {
                    lineas.push(`<div class="cc-line text-dark"><span>Hechizo ·</span><strong>Al entrar</strong></div>`);
                }

                estado.items.forEach(item => {
                    if (item.kind === 'desc') {
                        const texto = (item.texto || '').trim();
                        if (!texto) {
                            lineas.push(`<div class="cc-line fst-italic text-body-secondary">Escribe tu descripción...</div>`);
                        } else {
                            const sublineas = partirEnLineas(texto, 30, item.lineas);
                            sublineas.forEach(sl => {
                                lineas.push(`<div class="cc-line fst-italic text-body-secondary">${escaparHtml(sl)}</div>`);
                            });
                        }
                    } else {
                        const ef = EFECTOS[item.tipoHabilidad] || EFECTOS[2];
                        const prefijo = estado.tipo === 1
                            ? `<span class="fw-semibold text-dark">${ef.cuandoFijo || EVENTOS[item.tipoEstado] || 'Al entrar'}:</span>`
                            : '';
                        lineas.push(lineaEfectoHtml(item, prefijo));
                    }
                });
                return lineas.join('');
            }

            function lineaEfectoHtml(b, prefijoCuando) {
                const ico = `<span class="cc-inline-ico">${iconoSvg(b.tipoHabilidad, 13)}</span>`;
                const num = `<strong class="text-dark">${b.cantidad}</strong>`;
                let detalle = '';
                if (b.tipoHabilidad === 4) detalle = `<span>carta(s)</span>`;
                else if (b.tipoHabilidad === 5) detalle = `<span>mano rival</span>`;
                else if (b.tipoHabilidad === 6) detalle = `<span>carta (${OBJETIVOS[b.tipoObjetivo] || 'Enemigo'})</span>`;
                else if (b.tipoHabilidad === 7) detalle = `<span>al atacante</span>`;
                else detalle = `<span>a ${OBJETIVOS[b.tipoObjetivo] || 'Enemigo'}</span>`;

                return `<div class="cc-line">${prefijoCuando}${ico}${num}${detalle}</div>`;
            }

            function mostrarAvisoLimite(msg) {
                avisoLimite.textContent = msg;
                avisoLimite.classList.toggle('d-none', !msg);
            }

            function recortarDescripcionesExcedentes() {
                while (lineasDescUsadas() > maxLineasDescActual()) {
                    const exceso = lineasDescUsadas() - maxLineasDescActual();
                    const idxDesc = estado.items.findLastIndex(x => x.kind === 'desc');
                    if (idxDesc === -1) break;
                    if (exceso === 1 && estado.items[idxDesc].lineas === 2) {
                        estado.items[idxDesc].lineas = 1;
                        estado.items[idxDesc].texto = (estado.items[idxDesc].texto || '').slice(0, 30);
                    } else {
                        estado.items.splice(idxDesc, 1);
                    }
                }
            }

            const GRIP_SVG = `<span class="scratch-drag-handle" title="Arrastra para reordenar"><svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><circle cx="5" cy="3.5" r="1.25"/><circle cx="11" cy="3.5" r="1.25"/><circle cx="5" cy="8" r="1.25"/><circle cx="11" cy="8" r="1.25"/><circle cx="5" cy="12.5" r="1.25"/><circle cx="11" cy="12.5" r="1.25"/></svg></span>`;
            let dragSourceIdx = null;

            function limpiarIndicadoresDrop() {
                pila.querySelectorAll('.scratch-item-group').forEach(g => {
                    g.classList.remove('drop-before', 'drop-after', 'is-dragging');
                });
            }

            function renderPila() {
                pila.innerHTML = '';
                document.getElementById('paletaDefensa').classList.toggle('d-none', estado.tipo === 2);

                const hat = document.createElement('div');
                hat.className = 'scratch-block block-hat';
                if (estado.tipo === 1) {
                    hat.innerHTML = `
                        <span>Criatura</span>
                        <span class="small text-body-secondary">ATK</span>
                        <input type="number" min="1" max="99" value="${estado.ataque}" class="scratch-pill input-number" id="hatAtaque" />
                        <span class="small text-body-secondary">VID</span>
                        <input type="number" min="1" max="99" value="${estado.vida}" class="scratch-pill input-number" id="hatVida" />
                    `;
                } else {
                    hat.innerHTML = `<span>Hechizo</span><span class="small text-body-secondary">(se aplica al lanzarse)</span>`;
                }
                pila.appendChild(hat);

                if (estado.tipo === 1) {
                    document.getElementById('hatAtaque').addEventListener('input', e => {
                        estado.ataque = Math.max(1, parseInt(e.target.value, 10) || 1);
                        sincronizarTodo();
                    });
                    document.getElementById('hatVida').addEventListener('input', e => {
                        estado.vida = Math.max(1, parseInt(e.target.value, 10) || 1);
                        sincronizarTodo();
                    });
                }

                estado.items.forEach((item, idx) => {
                    const group = document.createElement('div');
                    group.className = 'scratch-item-group';
                    group.setAttribute('draggable', 'true');
                    group.dataset.itemIdx = String(idx);

                    const botonQuitar = `<button type="button" class="btn btn-sm btn-link text-secondary p-0 ms-auto text-decoration-none" data-remove="${idx}" title="Quitar">x</button>`;

                    if (item.kind === 'desc') {
                        const maxCar = item.lineas === 2 ? 60 : 30;
                        const descDiv = document.createElement('div');
                        descDiv.className = 'scratch-block block-stack block-when w-100';
                        descDiv.innerHTML = `
                            ${GRIP_SVG}
                            <span class="small text-body-secondary">${item.lineas === 2 ? 'Desc. larga:' : 'Descripción:'}</span>
                            <input type="text" maxlength="${maxCar}" value="${escaparHtml(item.texto)}" placeholder="Ej. Le gusta el salmón" class="scratch-pill flex-grow-1" style="min-width: 120px;" data-desc-idx="${idx}" />
                            <span class="small text-body-secondary" data-desc-count="${idx}">${(item.texto || '').length}/${maxCar}</span>
                            ${botonQuitar}
                        `;
                        group.appendChild(descDiv);
                    } else {
                        const ef = EFECTOS[item.tipoHabilidad] || EFECTOS[2];
                        const permitidos = objetivosPermitidos(item.tipoHabilidad);
                        if (!permitidos.includes(item.tipoObjetivo)) item.tipoObjetivo = permitidos[0];
                        if (ef.cantidadFija !== null) item.cantidad = ef.cantidadFija;
                        if (estado.tipo === 2 || ef.cuandoFijo) item.tipoEstado = 1;

                        const whenDiv = document.createElement('div');
                        whenDiv.className = 'scratch-block block-stack block-when w-100';
                        if (ef.cuandoFijo) {
                            whenDiv.innerHTML = `${GRIP_SVG}<span class="small text-body-secondary">Cuándo:</span><span>${ef.cuandoFijo}</span>${botonQuitar}`;
                        } else if (estado.tipo === 1) {
                            whenDiv.innerHTML = `
                                ${GRIP_SVG}
                                <span class="small text-body-secondary">Cuándo:</span>
                                <select class="scratch-pill" data-field="tipoEstado" data-idx="${idx}">
                                    ${Object.entries(EVENTOS).map(([k, v]) => `<option value="${k}" ${Number(k) === item.tipoEstado ? 'selected' : ''}>${v}</option>`).join('')}
                                </select>
                                ${botonQuitar}
                            `;
                        } else {
                            whenDiv.innerHTML = `${GRIP_SVG}<span class="small text-body-secondary">Cuándo:</span><span>Al entrar (instantáneo)</span>${botonQuitar}`;
                        }
                        group.appendChild(whenDiv);

                        const efDiv = document.createElement('div');
                        efDiv.className = 'scratch-block block-stack block-effect-child';

                        const cantidadHtml = ef.cantidadFija !== null
                            ? `<span class="badge text-bg-light border">1</span>`
                            : `<input type="number" min="1" max="99" value="${item.cantidad}" class="scratch-pill input-number" data-field="cantidad" data-idx="${idx}" />`;

                        let objetivoHtml = '';
                        if (permitidos.length > 1) {
                            objetivoHtml = `<span class="small text-body-secondary">a</span>
                                <select class="scratch-pill" data-field="tipoObjetivo" data-idx="${idx}">
                                    ${permitidos.map(k => `<option value="${k}" ${k === item.tipoObjetivo ? 'selected' : ''}>${OBJETIVOS[k]}</option>`).join('')}
                                </select>`;
                        } else if (item.tipoHabilidad === 7) {
                            objetivoHtml = `<span class="small text-body-secondary">al atacante</span>`;
                        } else if (item.tipoHabilidad === 3) {
                            objetivoHtml = `<span class="small text-body-secondary">a Jugador</span>`;
                        }

                        efDiv.innerHTML = `<span>${ef.nombre}</span>${cantidadHtml}${objetivoHtml}`;
                        group.appendChild(efDiv);
                    }

                    // Permitir escribir/seleccionar en inputs y selects sin activar drag accidental
                    group.querySelectorAll('input, select, button').forEach(ctrl => {
                        ctrl.addEventListener('mousedown', () => group.setAttribute('draggable', 'false'));
                        ctrl.addEventListener('mouseup', () => group.setAttribute('draggable', 'true'));
                        ctrl.addEventListener('blur', () => group.setAttribute('draggable', 'true'));
                    });

                    // Eventos HTML5 Drag & Drop para reordenar o soltar desde la paleta
                    group.addEventListener('dragstart', e => {
                        dragSourceIdx = idx;
                        group.classList.add('is-dragging');
                        e.dataTransfer.effectAllowed = 'move';
                        e.dataTransfer.setData('text/plain', JSON.stringify({ kind: 'reorder', fromIdx: idx }));
                    });

                    group.addEventListener('dragend', () => {
                        dragSourceIdx = null;
                        limpiarIndicadoresDrop();
                    });

                    group.addEventListener('dragover', e => {
                        e.preventDefault();
                        e.stopPropagation();
                        const rect = group.getBoundingClientRect();
                        const enMitadSuperior = e.clientY < rect.top + rect.height / 2;
                        pila.querySelectorAll('.scratch-item-group').forEach(g => {
                            if (g !== group) g.classList.remove('drop-before', 'drop-after');
                        });
                        group.classList.toggle('drop-before', enMitadSuperior);
                        group.classList.toggle('drop-after', !enMitadSuperior);
                    });

                    group.addEventListener('dragleave', e => {
                        if (!group.contains(e.relatedTarget)) {
                            group.classList.remove('drop-before', 'drop-after');
                        }
                    });

                    group.addEventListener('drop', e => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.remove('drag-over');
                        const rect = group.getBoundingClientRect();
                        const enMitadSuperior = e.clientY < rect.top + rect.height / 2;
                        const targetPos = enMitadSuperior ? idx : idx + 1;
                        limpiarIndicadoresDrop();

                        try {
                            const data = JSON.parse(e.dataTransfer.getData('text/plain'));
                            if (data.kind === 'reorder') {
                                const fromIdx = Number(data.fromIdx);
                                if (Number.isNaN(fromIdx) || fromIdx === targetPos || fromIdx + 1 === targetPos) return;
                                const [movido] = estado.items.splice(fromIdx, 1);
                                const insertPos = fromIdx < targetPos ? targetPos - 1 : targetPos;
                                estado.items.splice(insertPos, 0, movido);
                                renderPila();
                            } else {
                                aplicarBloque(data.kind, data.value, targetPos);
                            }
                        } catch { }
                    });

                    pila.appendChild(group);
                });

                pila.querySelectorAll('[data-field]').forEach(el => {
                    el.addEventListener('change', onCampoBloqueChange);
                    el.addEventListener('input', onCampoBloqueChange);
                });
                pila.querySelectorAll('[data-desc-idx]').forEach(el => {
                    el.addEventListener('input', e => {
                        const idx = Number(e.target.dataset.descIdx);
                        const val = e.target.value.replace(/"/g, '');
                        if (val !== e.target.value) e.target.value = val;
                        estado.items[idx].texto = val;
                        const maxCar = estado.items[idx].lineas === 2 ? 60 : 30;
                        const counter = pila.querySelector(`[data-desc-count="${idx}"]`);
                        if (counter) counter.textContent = `${val.length}/${maxCar}`;
                        sincronizarTodo();
                    });
                });
                pila.querySelectorAll('[data-remove]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        estado.items.splice(Number(btn.dataset.remove), 1);
                        mostrarAvisoLimite('');
                        renderPila();
                    });
                });

                sincronizarTodo();
            }

            function onCampoBloqueChange(e) {
                const idx = Number(e.target.dataset.idx);
                const field = e.target.dataset.field;
                estado.items[idx][field] = Math.max(1, parseInt(e.target.value, 10) || 1);
                sincronizarTodo();
            }

            function sincronizarTodo() {
                const mana = calcularMana();
                const textoPlano = generarTextoPlano();
                const rar = RAREZAS[parseInt(inpRareza.value, 10)] || RAREZAS[1];
                const esRota = mana > 10;
                const habs = obtenerHabilidades();

                const descMax = maxLineasDescActual();
                const descUsadas = lineasDescUsadas();
                const descLibres = descMax - descUsadas;
                document.getElementById('contadorHabilidades').textContent = `${habs.length} / ${maxHabilidadesActual()} hab.`;
                document.getElementById('contadorDesc').textContent = `${descUsadas} / ${descMax} lín. texto`;
                document.getElementById('paletaDescCorta').classList.toggle('is-disabled', descLibres < 1);
                document.getElementById('paletaDescLarga').classList.toggle('is-disabled', descLibres < 2);

                const badgeBalance = document.getElementById('badgeBalance');
                badgeBalance.textContent = esRota ? `Demasiado rota (${mana}/10 maná)` : `Equilibrada (${mana}/10 maná)`;
                badgeBalance.className = esRota
                    ? 'badge text-bg-danger px-3 py-2'
                    : 'badge text-bg-light border px-3 py-2';
                document.getElementById('alertaRota').classList.toggle('d-none', !esRota);
                document.getElementById('btnGuardar').disabled = esRota;

                inpMana.value = mana;
                document.getElementById('hidTipo').value = estado.tipo;
                document.getElementById('hidAtaque').value = estado.tipo === 1 ? estado.ataque : 0;
                document.getElementById('hidVida').value = estado.tipo === 1 ? estado.vida : 0;
                document.getElementById('hidDescripcion').value = textoPlano;

                const hiddenBloques = document.getElementById('hiddenBloques');
                hiddenBloques.innerHTML = habs.map((b, i) => `
                    <input type="hidden" name="Bloques[${i}].TipoEstado" value="${estado.tipo === 2 ? 1 : b.tipoEstado}" />
                    <input type="hidden" name="Bloques[${i}].TipoHabilidad" value="${b.tipoHabilidad}" />
                    <input type="hidden" name="Bloques[${i}].Cantidad" value="${b.cantidad}" />
                    <input type="hidden" name="Bloques[${i}].TipoObjetivo" value="${b.tipoObjetivo}" />
                    <input type="hidden" name="Bloques[${i}].Objetivo" value="${b.objetivo}" />
                `).join('');

                document.getElementById('prevNombre').textContent = inpNombre.value.trim() || 'Nombre de la carta';
                document.getElementById('prevRarezaText').textContent = rar.etiqueta;
                document.getElementById('prevDescripcion').innerHTML = generarHtmlPreview();
                document.getElementById('prevManaBadge').textContent = mana;
                document.getElementById('prevVidaNum').textContent = estado.vida;

                const iconsLeft = document.getElementById('prevIconsLeft');
                iconsLeft.innerHTML = '';
                habs.slice(0, 2).forEach(b => {
                    const div = document.createElement('div');
                    div.className = 'cc-icon-badge';
                    div.title = (EFECTOS[b.tipoHabilidad] || { nombre: '' }).nombre;
                    div.innerHTML = iconoSvg(b.tipoHabilidad, 17);
                    iconsLeft.appendChild(div);
                });

                const iconRight = document.getElementById('prevIconRight');
                if (estado.tipo === 1) {
                    iconRight.innerHTML = `${iconoSvg(1, 17)}<span>${estado.ataque}</span>`;
                    iconRight.classList.remove('d-none');
                } else if (habs.length >= 3) {
                    iconRight.innerHTML = iconoSvg(habs[2].tipoHabilidad, 17);
                    iconRight.classList.remove('d-none');
                } else {
                    iconRight.classList.add('d-none');
                }

                actualizarAlternanciaCentro();
            }

            function actualizarAlternanciaCentro() {
                const manaEl = document.getElementById('prevManaBadge');
                const heartEl = document.getElementById('prevHeartBadge');
                const nota = document.getElementById('notaAlternancia');

                if (estado.tipo === 1 && mostrandoVida) {
                    manaEl.classList.add('d-none');
                    heartEl.classList.remove('d-none');
                } else {
                    manaEl.classList.remove('d-none');
                    heartEl.classList.add('d-none');
                }
                nota.textContent = estado.tipo === 1
                    ? 'Alterna entre Maná (círculo) y Vida (corazón).'
                    : 'Hechizo: muestra el coste de Maná.';
            }

            setInterval(() => {
                if (estado.tipo === 1) {
                    mostrandoVida = !mostrandoVida;
                    actualizarAlternanciaCentro();
                }
            }, 2500);

            document.getElementById('prevCenterSlot').addEventListener('click', () => {
                if (estado.tipo === 1) {
                    mostrandoVida = !mostrandoVida;
                    actualizarAlternanciaCentro();
                }
            });

            function aplicarBloque(kind, value, insertAt) {
                const val = Number(value);
                mostrarAvisoLimite('');

                if (kind === 'tipo') {
                    estado.tipo = val;
                    if (val === 1) {
                        estado.ataque = Math.max(1, estado.ataque);
                        estado.vida = Math.max(1, estado.vida);
                        let contHabs = 0;
                        estado.items = estado.items.filter(x => x.kind !== 'hab' || ++contHabs <= 2);
                    } else {
                        mostrandoVida = false;
                        estado.items = estado.items
                            .filter(x => !(x.kind === 'hab' && x.tipoHabilidad === 7))
                            .map(x => x.kind === 'hab' ? { ...x, tipoEstado: 1 } : x);
                    }
                    recortarDescripcionesExcedentes();
                } else if (kind === 'efecto') {
                    if (estado.tipo === 2 && val === 7) return;
                    if (obtenerHabilidades().length >= maxHabilidadesActual()) {
                        mostrarAvisoLimite(estado.tipo === 1
                            ? 'Una criatura puede tener como máximo 2 habilidades.'
                            : 'Un hechizo puede tener como máximo 3 efectos.');
                        return;
                    }
                    const ef = EFECTOS[val] || EFECTOS[2];
                    const permitidos = objetivosPermitidos(val);
                    const nuevoHab = {
                        kind: 'hab',
                        tipoEstado: 1,
                        tipoHabilidad: val,
                        cantidad: ef.cantidadFija ?? 1,
                        tipoObjetivo: permitidos[0],
                        objetivo: 1
                    };
                    if (typeof insertAt === 'number' && insertAt >= 0 && insertAt <= estado.items.length) {
                        estado.items.splice(insertAt, 0, nuevoHab);
                    } else {
                        estado.items.push(nuevoHab);
                    }
                    recortarDescripcionesExcedentes();
                } else if (kind === 'desc') {
                    const lineasNuevas = val === 2 ? 2 : 1;
                    const disponibles = maxLineasDescActual() - lineasDescUsadas();
                    if (lineasNuevas > disponibles) {
                        mostrarAvisoLimite(disponibles <= 0
                            ? 'No quedan líneas libres de descripción en esta carta.'
                            : 'Solo queda 1 línea libre: añade una Descripción corta (1 línea).');
                        return;
                    }
                    const nuevaDesc = { kind: 'desc', lineas: lineasNuevas, texto: '' };
                    if (typeof insertAt === 'number' && insertAt >= 0 && insertAt <= estado.items.length) {
                        estado.items.splice(insertAt, 0, nuevaDesc);
                    } else {
                        estado.items.push(nuevaDesc);
                    }
                }
                renderPila();
            }

            document.querySelectorAll('.block-palette').forEach(el => {
                el.addEventListener('click', () => aplicarBloque(el.dataset.kind, el.dataset.value));
                el.addEventListener('dragstart', e => {
                    e.dataTransfer.setData('text/plain', JSON.stringify({ kind: el.dataset.kind, value: el.dataset.value }));
                });
            });

            dropzone.addEventListener('dragover', e => {
                e.preventDefault();
                dropzone.classList.add('drag-over');
            });
            dropzone.addEventListener('dragleave', () => dropzone.classList.remove('drag-over'));
            dropzone.addEventListener('drop', e => {
                e.preventDefault();
                dropzone.classList.remove('drag-over');
                limpiarIndicadoresDrop();
                try {
                    const data = JSON.parse(e.dataTransfer.getData('text/plain'));
                    if (data.kind === 'reorder') {
                        const fromIdx = Number(data.fromIdx);
                        if (!Number.isNaN(fromIdx) && fromIdx >= 0 && fromIdx < estado.items.length) {
                            const [movido] = estado.items.splice(fromIdx, 1);
                            estado.items.push(movido);
                            renderPila();
                        }
                    } else {
                        aplicarBloque(data.kind, data.value);
                    }
                } catch { }
            });

            document.getElementById('btnLimpiar').addEventListener('click', () => {
                estado.items = [];
                mostrarAvisoLimite('');
                renderPila();
            });

            inpNombre.addEventListener('input', sincronizarTodo);
            inpRareza.addEventListener('change', sincronizarTodo);

            inpImagen.addEventListener('change', () => {
                const prevImg = document.getElementById('prevImagen');
                const prevLabel = document.getElementById('prevArtLabel');
                if (inpImagen.files && inpImagen.files[0]) {
                    prevImg.src = URL.createObjectURL(inpImagen.files[0]);
                    prevImg.classList.remove('d-none');
                    prevLabel.classList.add('d-none');
                } else {
                    prevImg.classList.add('d-none');
                    prevLabel.classList.remove('d-none');
                }
            });

            renderPila();
        })();
    </script>
}
