@model CraftCaster.Web.ViewModels.CreadorCartaViewModel
@using CraftCaster.Domain.Enums
@{
    ViewData["Title"] = "Editar carta";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Editar carta</h1>
        <p class="text-body-secondary mb-0">Modifica los datos de tu carta o sube una nueva imagen.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.Id">Volver al detalle</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Tipo" class="form-label"></label>
                    <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoCarta>()" class="form-select" id="inpTipo"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Rareza" class="form-label"></label>
                    <select asp-for="Rareza" asp-items="Html.GetEnumSelectList<Rareza>()" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="CosteMana" class="form-label"></label>
                    <input asp-for="CosteMana" type="number" min="0" max="20" class="form-control" />
                    <span asp-validation-for="CosteMana" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mb-3" id="grupoStats">
                <div class="col-md-6">
                    <label asp-for="Ataque" class="form-label"></label>
                    <input asp-for="Ataque" type="number" min="0" max="99" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Vida" class="form-label"></label>
                    <input asp-for="Vida" type="number" min="0" max="99" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ImagenUrlActual))
            {
                <div class="mb-2">
                    <div class="small text-body-secondary mb-1">Imagen actual:</div>
                    <img src="@Model.ImagenUrlActual" alt="@Model.Nombre" class="img-thumbnail" style="max-height: 140px;" />
                </div>
            }

            <div class="mb-3">
                <label asp-for="ImagenArchivo" class="form-label">Nueva imagen (opcional)</label>
                <input asp-for="ImagenArchivo" type="file" accept="image/*" class="form-control" />
            </div>

            <div class="form-check mb-4">
                <input asp-for="EsPublica" class="form-check-input" />
                <label asp-for="EsPublica" class="form-check-label"></label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.Id">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const inpTipo = document.getElementById('inpTipo');
            const grupoStats = document.getElementById('grupoStats');
            function toggleStats() {
                const esCriatura = inpTipo.options[inpTipo.selectedIndex].text === 'Criatura';
                grupoStats.classList.toggle('d-none', !esCriatura);
            }
            inpTipo.addEventListener('change', toggleStats);
            toggleStats();
        })();
    </script>
}
