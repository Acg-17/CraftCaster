@model IReadOnlyList<CraftCaster.Domain.Entities.Carta>
@using CraftCaster.Domain.Enums
@{
    ViewData["Title"] = "Mis cartas";
    var imagenes = ViewBag.Imagenes as Dictionary<int, string?> ?? new();
    var autores = ViewBag.Autores as Dictionary<int, string> ?? new();
    var usuarioActualId = ViewBag.UsuarioActualId is int uid ? uid : 0;
    var origenActual = ViewBag.Origen as string ?? string.Empty;
}

<link rel="stylesheet" href="~/css/wireframe-cartas.css" asp-append-version="true" />

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 mb-1">Mis cartas</h1>
            <p class="text-body-secondary mb-0">Gestiona tus cartas creadas y consulta también las cartas incluidas en los mazos de tu colección.</p>
        </div>
        <a class="btn btn-dark" asp-action="Crear">+ Crear carta</a>
    </div>
</div>

<!-- Barra de filtros usando los ReadFilter de Carta (Nombre/Autor, Origen, Tipo, Rareza, Maná) -->
<form asp-action="Index" method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold mb-1">Buscar</label>
                <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Nombre o @@usuario..." />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">Origen</label>
                <select name="origen" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(origenActual))">Todas</option>
                    <option value="propias" selected="@(origenActual == "propias")">Mis cartas</option>
                    <option value="externas" selected="@(origenActual == "externas")">De otros usuarios</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">Tipo</label>
                <select name="tipo" class="form-select">
                    <option value="">Todos</option>
                    @foreach (TipoCarta t in Enum.GetValues<TipoCarta>())
                    {
                        <option value="@((int)t)" selected="@(ViewBag.Tipo is TipoCarta selT && selT == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold mb-1">Rareza</label>
                <select name="rareza" class="form-select">
                    <option value="">Todas</option>
                    @foreach (Rareza r in Enum.GetValues<Rareza>())
                    {
                        <option value="@((int)r)" selected="@(ViewBag.Rareza is Rareza selR && selR == r)">@r</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-1">
                <label class="form-label small fw-semibold mb-1">Maná</label>
                <input type="number" name="mana" value="@ViewBag.Mana" min="0" max="10" class="form-control" placeholder="-" />
            </div>
            <div class="col-12 col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </div>
    </div>
</form>

@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show" role="alert">
        @exito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5 text-center">
            <h2 class="h5">No se encontraron cartas</h2>
            <p class="text-body-secondary mb-3">Crea tu primera Criatura o Hechizo, o copia un mazo desde Explorar para ver sus cartas aquí.</p>
            <a class="btn btn-primary" asp-action="Crear">Crear carta</a>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-4">
        @foreach (var carta in Model)
        {
            imagenes.TryGetValue(carta.Id, out var imgUrl);
            autores.TryGetValue(carta.Id, out var autor);
            bool esPropia = carta.Usuario is not null && carta.Usuario.Id == usuarioActualId;
            var vd = new ViewDataDictionary(ViewData) { ["ImagenUrl"] = imgUrl, ["Compacta"] = false };
            <div class="d-flex flex-column align-items-center" style="width: 240px;">
                <partial name="_CartaTcg" model="carta" view-data="vd" />

                @if (!esPropia && !string.IsNullOrWhiteSpace(autor))
                {
                    <div class="small text-body-secondary mt-1">De @@@autor</div>
                }

                <div class="d-flex flex-wrap justify-content-center gap-1 mt-2 w-100">
                    <a class="btn btn-dark btn-sm" asp-action="Detalle" asp-route-id="@carta.Id">Ver</a>
                    @if (esPropia)
                    {
                        <a class="btn btn-outline-dark btn-sm" asp-action="Editar" asp-route-id="@carta.Id">Editar</a>
                        <form asp-action="Borrar" asp-route-id="@carta.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Seguro que quieres borrar esta carta?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Borrar</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/cartas-alternancia.js" asp-append-version="true"></script>
}
