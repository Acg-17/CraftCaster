@model CraftCaster.Web.ViewModels.DetalleMazoViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = Model.Mazo.Nombre;
    var estrellas = (int)Math.Round(Model.Mazo.Valoracion);
    var curva = Model.CurvaMana;
    var maximo = Math.Max(1, curva.Max(c => c.Cantidad));
    var cartasEntidad = ViewBag.CartasEntidad as List<CraftCaster.Domain.Entities.Carta> ?? new();
    string? BuscarImagenCarta(int cartaId)
    {
        var dir = System.IO.Path.Combine(Env.WebRootPath, "uploads", "cartas");
        if (!System.IO.Directory.Exists(dir)) return null;
        var file = System.IO.Directory.GetFiles(dir, $"carta_{cartaId}.*").FirstOrDefault();
        return file is null ? null : $"/uploads/cartas/{System.IO.Path.GetFileName(file)}";
    }
}

<link rel="stylesheet" href="~/css/wireframe-cartas.css" asp-append-version="true" />

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="row g-4 mb-4 align-items-stretch">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <h1 class="h3 mb-1">@Model.Mazo.Nombre</h1>
                    <p class="text-body-secondary mb-2">Por @@@Model.Mazo.UsuarioLabel</p>
                    <span class="badge text-bg-light border">@Model.Mazo.EstadoMazo</span>
                    <span class="badge @(Model.Mazo.EsPublico ? "text-bg-primary" : "text-bg-secondary")">@(Model.Mazo.EsPublico ? "Público" : "Privado")</span>
                </div>
                <dl class="row mb-0 small text-md-end" style="min-width: 190px;">
                    <dt class="col-6 col-md-7 text-body-secondary">Cartas</dt><dd class="col-6 col-md-5 mb-1">@Model.Mazo.NumCartas / 30</dd>
                    <dt class="col-6 col-md-7 text-body-secondary">Coste medio</dt><dd class="col-6 col-md-5 mb-1">@Model.Mazo.CosteMedio.ToString("0.0")</dd>
                    <dt class="col-6 col-md-7 text-body-secondary">Valoración</dt>
                    <dd class="col-6 col-md-5 mb-0 text-warning">@for (var i = 1; i <= 5; i++) { @(i <= estrellas ? "★" : "☆") }</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <section class="card border-0 shadow-sm h-100">
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div class="small fw-semibold text-body-secondary mb-2">Curva de maná</div>
                <div class="d-flex align-items-end gap-2" style="height: 72px" aria-label="Cartas por coste de maná">
                    @foreach (var punto in curva)
                    {
                        var alto = (int)Math.Round(100.0 * punto.Cantidad / maximo);
                        <div class="flex-fill d-flex flex-column align-items-center justify-content-end h-100">
                            <span class="text-body-secondary" style="font-size: 0.7rem;">@punto.Cantidad</span>
                            <div class="w-100 bg-primary rounded-top" style="height: @(alto)%; min-height: 2px"></div>
                        </div>
                    }
                </div>
                <div class="d-flex gap-2 mt-1 border-top pt-1">
                    @foreach (var punto in curva)
                    {
                        <span class="flex-fill text-center text-body-secondary" style="font-size: 0.72rem;">@punto.Coste</span>
                    }
                </div>
            </div>
        </section>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <section class="card border-0 shadow-sm">
            <div class="card-header bg-body p-3"><h2 class="h5 mb-0">Cartas del mazo</h2></div>
            <div class="card-body p-0">
                @if (Model.Cartas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th class="ps-3">Maná</th><th>Carta</th><th>Tipo</th><th>Rareza</th><th class="text-end">Copias</th><th class="text-end pe-3">Vista</th></tr></thead>
                            <tbody>
                                @foreach (var carta in Model.Cartas)
                                {
                                    <tr class="js-fila-carta" data-carta-id="@carta.CartaId" style="cursor: pointer;">
                                        <td class="ps-3"><span class="badge rounded-pill text-bg-primary">@carta.CosteMana</span></td>
                                        <td class="fw-semibold">@carta.Nombre</td>
                                        <td>@carta.Tipo</td>
                                        <td>@carta.Rareza</td>
                                        <td class="text-end">x@(carta.Cantidad)</td>
                                        <td class="text-end pe-3">
                                            <button type="button" class="btn btn-sm btn-outline-dark py-0 px-2 js-ver-carta" data-carta-id="@carta.CartaId" title="Previsualizar carta">Ver</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="p-3 mb-0 text-body-secondary">Este mazo todavía no tiene cartas.</p>
                }
            </div>
        </section>
    </div>

    <div class="col-lg-4 d-flex flex-column gap-4">
        @if (cartasEntidad.Any())
        {
            <section class="card border-0 shadow-sm">
                <div class="card-header bg-body p-3 d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Vista previa de carta</h2>
                    <span class="small text-body-secondary">Haz clic en una fila</span>
                </div>
                <div class="card-body d-flex justify-content-center pb-4">
                    @for (int idx = 0; idx < cartasEntidad.Count; idx++)
                    {
                        var entidad = cartasEntidad[idx];
                        var vd = new ViewDataDictionary(ViewData) { ["ImagenUrl"] = BuscarImagenCarta(entidad.Id), ["Compacta"] = false };
                        <div class="js-preview-carta @(idx == 0 ? "" : "d-none")" data-carta-id="@entidad.Id">
                            <partial name="_CartaTcg" model="entidad" view-data="vd" />
                        </div>
                    }
                </div>
            </section>
        }

        @if (Model.PuedeValorar)
        {
            <section class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Valorar este mazo</h2>
                    <form asp-action="Valorar" asp-route-id="@Model.Mazo.Id" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <select asp-for="Valorar.Valoracion" class="form-select" aria-label="Tu valoración">
                            <option value="">Elige...</option>
                            <option value="5">★★★★★ (5)</option>
                            <option value="4">★★★★☆ (4)</option>
                            <option value="3">★★★☆☆ (3)</option>
                            <option value="2">★★☆☆☆ (2)</option>
                            <option value="1">★☆☆☆☆ (1)</option>
                        </select>
                        <button type="submit" class="btn btn-dark">Valorar</button>
                    </form>
                </div>
            </section>

            <section class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h6 fw-semibold mb-2">Copiar a mis mazos</h2>
                    <p class="small text-body-secondary mb-3">Guarda una copia editable de este mazo en tu colección manteniendo el crédito de @@@Model.Mazo.UsuarioLabel.</p>
                    <form asp-action="Copiar" asp-route-id="@Model.Mazo.Id" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100">Copiar a mis mazos</button>
                    </form>
                </div>
            </section>

            <section class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h6 fw-semibold mb-2">Reportar mazo</h2>
                    <form asp-action="Reportar" asp-route-id="@Model.Mazo.Id" method="post" class="d-flex flex-column gap-2"
                          onsubmit="return confirm('¿Seguro que quieres reportar este mazo para revisión del administrador?');">
                        @Html.AntiForgeryToken()
                        <select name="motivo" class="form-select form-select-sm" aria-label="Motivo del reporte">
                            <option value="Contenido ofensivo o inapropiado">Contenido ofensivo o inapropiado</option>
                            <option value="Spam o plagio">Spam o plagio</option>
                            <option value="Nombre o descripción violenta">Nombre o descripción violenta</option>
                        </select>
                        <button type="submit" class="btn btn-outline-danger btn-sm">Enviar reporte</button>
                    </form>
                </div>
            </section>
        }
        else if (!Model.EsPropio)
        {
            <p class="small text-body-secondary mb-0"><a asp-controller="Cuenta" asp-action="Acceso" asp-route-returnUrl="@Context.Request.Path">Inicia sesión</a> para valorar este mazo.</p>
        }

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Volver a Explorar</a>
            <a asp-controller="Juego" asp-action="Index" class="btn btn-dark flex-fill">Luchar</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cartas-alternancia.js" asp-append-version="true"></script>
    <script>
        (function () {
            const filas = document.querySelectorAll('.js-fila-carta');
            const previews = document.querySelectorAll('.js-preview-carta');
            if (filas.length === 0 || previews.length === 0) return;

            function seleccionarCarta(cartaId) {
                previews.forEach(p => p.classList.toggle('d-none', p.dataset.cartaId !== cartaId));
                filas.forEach(f => f.classList.toggle('table-active', f.dataset.cartaId === cartaId));
            }

            filas.forEach(fila => {
                fila.addEventListener('click', () => seleccionarCarta(fila.dataset.cartaId));
            });

            // Marcar la primera carta por defecto
            seleccionarCarta(filas[0].dataset.cartaId);
        })();
    </script>
}
