@model CraftCaster.Web.ViewModels.ExplorarViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Explorar";
    string? BuscarPortadaMazo(int mazoId)
    {
        var dir = System.IO.Path.Combine(Env.WebRootPath, "uploads", "mazos");
        if (!System.IO.Directory.Exists(dir)) return null;
        var file = System.IO.Directory.GetFiles(dir, $"mazo_{mazoId}.*").FirstOrDefault();
        return file is null ? null : $"/uploads/mazos/{System.IO.Path.GetFileName(file)}";
    }
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h1 class="h3 mb-1">Explorar</h1>
            <p class="text-body-secondary mb-0">Descubre los mazos que comparte la comunidad.</p>
        </div>
        <a asp-controller="EditorMazo" asp-action="Crear" class="btn btn-dark">+ Crear mazo</a>
    </div>
</div>

<form asp-action="Index" method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
        }
        <div class="row g-2 align-items-end">
            <div class="col-12 col-lg-4">
                <label asp-for="Filtro.Nombre" class="form-label small fw-semibold"></label>
                <input asp-for="Filtro.Nombre" name="Nombre" class="form-control" placeholder="Nombre de mazo..." />
            </div>
            <div class="col-6 col-lg-2">
                <label asp-for="Filtro.CosteMin" class="form-label small fw-semibold"></label>
                <input asp-for="Filtro.CosteMin" name="CosteMin" type="number" min="0" max="20" class="form-control" />
            </div>
            <div class="col-6 col-lg-1">
                <label asp-for="Filtro.CosteMax" class="form-label small fw-semibold"></label>
                <input asp-for="Filtro.CosteMax" name="CosteMax" type="number" min="0" max="20" class="form-control" />
            </div>
            <div class="col-6 col-lg-2">
                <label asp-for="Filtro.ValoracionMin" class="form-label small fw-semibold"></label>
                <select asp-for="Filtro.ValoracionMin" name="ValoracionMin" asp-items="CraftCaster.Web.ViewModels.ExplorarViewModel.OpcionesValoracion" class="form-select"></select>
            </div>
            <div class="col-6 col-lg-2">
                <label asp-for="Filtro.Orden" class="form-label small fw-semibold"></label>
                <select asp-for="Filtro.Orden" name="Orden" asp-items="CraftCaster.Web.ViewModels.ExplorarViewModel.OpcionesOrden" class="form-select"></select>
            </div>
            <div class="col-12 col-lg-1 d-grid">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
        </div>
    </div>
</form>

@if (Model.Mazos.Any())
{
    <p class="text-body-secondary small">@Model.Mazos.Count mazo(s) encontrados</p>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
        @foreach (var mazo in Model.Mazos)
        {
            var estrellas = (int)Math.Round(mazo.Valoracion);
            var portadaUrl = BuscarPortadaMazo(mazo.Id);
            <div class="col">
                <div class="card border-0 shadow-sm h-100 overflow-hidden">
                    <div class="bg-body-tertiary d-flex align-items-center justify-content-center overflow-hidden" style="aspect-ratio: 16 / 9;">
                        @if (!string.IsNullOrEmpty(portadaUrl))
                        {
                            <img src="@portadaUrl" class="w-100 h-100 object-fit-cover" alt="@mazo.Nombre" />
                        }
                        else
                        {
                            <span class="small text-body-secondary">Ilustración del mazo</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge text-bg-light border">@mazo.EstadoMazo</span>
                            <span class="small text-body-secondary">@mazo.NumCartas cartas</span>
                        </div>
                        <h2 class="h6 mb-1">@mazo.Nombre</h2>
                        <p class="small text-body-secondary mb-2">Por @@@mazo.UsuarioLabel</p>
                        <p class="small mb-1">Coste medio: <strong>@mazo.CosteMedio.ToString("0.0")</strong></p>
                        <p class="mb-0 text-warning" title="Valoración @mazo.Valoracion.ToString("0.0") de 5">
                            @for (var i = 1; i <= 5; i++)
                            {
                                @(i <= estrellas ? "★" : "☆")
                            }
                            <span class="small text-body-secondary ms-1">@mazo.Valoracion.ToString("0.0")</span>
                        </p>
                    </div>
                    <div class="card-footer bg-body border-0 pt-0 pb-3 d-flex gap-2">
                        <a asp-action="Detalle" asp-route-id="@mazo.Id" class="btn btn-dark btn-sm flex-fill">Ver mazo</a>
                        <a asp-controller="Juego" asp-action="Index" class="btn btn-outline-dark btn-sm flex-fill">Luchar</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
            <h2 class="h5">No hay mazos con esos filtros</h2>
            <p class="text-body-secondary mb-3">Prueba con otro nombre o quita algún filtro.</p>
            <a asp-action="Index" class="btn btn-outline-dark">Ver todos los mazos</a>
        </div>
    </div>
}
