@using CraftCaster.Web.Utils.Security
@inject CraftCaster.Application.Services.UsuarioService UsuarioService
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    var usuarioSesion = Context.Session.GetUser<UsuarioViewModel>();
    var nombreMostrar = usuarioSesion?.NombreUsuario;
    int? uidActual = User.Identity?.IsAuthenticated == true && int.TryParse(User.Identity?.Name, out var parsedUid)
        ? parsedUid
        : usuarioSesion?.Id;
    if (string.IsNullOrWhiteSpace(nombreMostrar) && uidActual is int uidLookup)
    {
        var usuarioDb = await UsuarioService.ReadOIDAsync(uidLookup);
        nombreMostrar = usuarioDb?.NombreUsuario;
    }
    if (string.IsNullOrWhiteSpace(nombreMostrar))
    {
        nombreMostrar = User.Identity?.Name;
    }
    string? fotoNavbarUrl = null;
    if (uidActual is int uidFoto)
    {
        var dirPerfiles = System.IO.Path.Combine(Env.WebRootPath, "uploads", "perfiles");
        if (System.IO.Directory.Exists(dirPerfiles))
        {
            var archivoFoto = System.IO.Directory.GetFiles(dirPerfiles, $"usuario_{uidFoto}.*").FirstOrDefault();
            if (archivoFoto is not null)
            {
                fotoNavbarUrl = $"/uploads/perfiles/{System.IO.Path.GetFileName(archivoFoto)}";
            }
        }
    }
    var inicialNavbar = !string.IsNullOrWhiteSpace(nombreMostrar) ? nombreMostrar.Substring(0, 1).ToUpperInvariant() : "U";
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d6efd" />
    <title>@ViewData["Title"] · CraftCaster</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CraftCaster.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-body-tertiary">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">CraftCaster</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Mostrar u ocultar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Explorar" asp-action="Index">Explorar</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="MisCartas" asp-action="Index">Mis cartas</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="EditorMazo" asp-action="Index">Mis mazos</a></li>
                        }
                        @if (User.IsInRole(HariaWebAuthentication.RolCliente) || User.IsInRole(HariaWebAuthentication.RolAdmin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Juego" asp-action="Index">Jugar</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-lg-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-light btn-sm d-inline-flex align-items-center gap-2" asp-controller="Cuenta" asp-action="Index">
                            <span class="rounded-circle overflow-hidden bg-dark text-white d-inline-flex align-items-center justify-content-center" style="width: 22px; height: 22px; font-size: 0.72rem; font-weight: 700;">
                                @if (!string.IsNullOrEmpty(fotoNavbarUrl))
                                {
                                    <img src="@fotoNavbarUrl" alt="@nombreMostrar" class="w-100 h-100 object-fit-cover" />
                                }
                                else
                                {
                                    @inicialNavbar
                                }
                            </span>
                            <span>@nombreMostrar</span>
                        </a>
                        <form asp-controller="Cuenta" asp-action="Salir" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-light btn-sm" asp-controller="Cuenta" asp-action="Acceso">Iniciar sesión</a>
                    }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4 py-lg-5">
        @{
            var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
        }
        @if (User.IsInRole(HariaWebAuthentication.RolAdmin) && !string.Equals(controladorActual, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            <div class="d-flex justify-content-between align-items-center bg-body rounded-3 shadow-sm px-3 py-2 mb-4">
                <span class="small text-body-secondary">Sesión de administrador</span>
                <a asp-controller="Admin" asp-action="Index" class="btn btn-dark btn-sm">Volver al Panel de Admin</a>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top bg-body py-3 mt-auto">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 small text-body-secondary">
            <span>&copy; @DateTime.Now.Year CraftCaster</span>
            <nav aria-label="Pie de página" class="d-flex flex-wrap gap-3">
                <a asp-controller="Home" asp-action="Index" class="link-secondary text-decoration-none">Inicio</a>
                <a asp-controller="Explorar" asp-action="Index" class="link-secondary text-decoration-none">Explorar</a>
                <a asp-controller="Home" asp-action="Desarrolladores" class="link-secondary text-decoration-none">Desarrolladores</a>
                <a asp-controller="Home" asp-action="Privacy" class="link-secondary text-decoration-none">Privacidad</a>
            </nav>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
