@model CraftCaster.Domain.Entities.Carta
@using CraftCaster.Domain.Enums
@{
    var imgUrl = ViewData["ImagenUrl"] as string;
    var esCompacta = (ViewData["Compacta"] as bool?) == true;
    var esCriatura = Model.Tipo == TipoCarta.Criatura;

    var habilidades = (Model.Estados ?? Enumerable.Empty<CraftCaster.Domain.Entities.Estado>())
        .SelectMany(e => (e.Habilidades ?? Enumerable.Empty<CraftCaster.Domain.Entities.Habilidad>())
            .Select(h => (Estado: e.Tipo, Hab: h)))
        .ToList();

    string IconoSvg(TipoHabilidad tipo, int size = 16) => tipo switch
    {
        TipoHabilidad.Ataque => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><path d='M14.5 3.5L20.5 3.5L20.5 9.5L10 20L4 14L14.5 3.5Z'/><line x1='3' y1='21' x2='7' y2='17'/><line x1='6' y1='12' x2='12' y2='18'/></svg>",
        TipoHabilidad.Danyo => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><polygon points='13 2 4 14 11 14 10 22 20 10 13 10 13 2'/></svg>",
        TipoHabilidad.Cura => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><path d='M12 20 C12 20 4 14 4 8.5 C4 5.5 6.5 3.5 9 3.5 C10.6 3.5 11.6 4.4 12 5.5 C12.4 4.4 13.4 3.5 15 3.5 C17.5 3.5 20 5.5 20 8.5 C20 14 12 20 12 20 Z'/><line x1='12' y1='8.5' x2='12' y2='14.5'/><line x1='9' y1='11.5' x2='15' y2='11.5'/></svg>",
        TipoHabilidad.Robar => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><rect x='7' y='4' width='12' height='16' rx='1.5'/><line x1='4' y1='12' x2='10' y2='12'/><line x1='7' y1='9' x2='7' y2='15'/></svg>",
        TipoHabilidad.Descartar => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><polyline points='3 6 5 6 21 6'/><path d='M6 6L7 20H17L18 6'/><line x1='10' y1='10' x2='10' y2='16'/><line x1='14' y1='10' x2='14' y2='16'/></svg>",
        TipoHabilidad.Destruir => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><circle cx='12' cy='9' r='5'/><circle cx='10' cy='8.5' r='0.8' fill='#212529'/><circle cx='14' cy='8.5' r='0.8' fill='#212529'/><line x1='5' y1='19' x2='19' y2='15'/><line x1='5' y1='15' x2='19' y2='19'/></svg>",
        TipoHabilidad.Defensa => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><path d='M12 3L4 6V12C4 16.5 7.5 19.5 12 21C16.5 19.5 20 16.5 20 12V6L12 3Z'/></svg>",
        _ => ""
    };

    string TextoCuando(TipoEstado est, TipoHabilidad hab)
    {
        if (hab == TipoHabilidad.Defensa) return "Al recibir daño";
        return est switch
        {
            TipoEstado.Entrar => "Al entrar",
            TipoEstado.Atacar => "Al atacar",
            TipoEstado.InicioTurno => "Al iniciar turno",
            TipoEstado.FinTurno => "Al finalizar turno",
            TipoEstado.Morir => "Al morir",
            _ => "Al entrar"
        };
    }

    string TextoObjetivo(TipoObjetivo obj) => obj switch
    {
        TipoObjetivo.Jugador => "Jugador",
        TipoObjetivo.Enemigo => "Enemigo",
        TipoObjetivo.TodosEnemigos => "Todos los enemigos",
        TipoObjetivo.Self => "Sí mismo",
        _ => "Enemigo"
    };
}

<div class="cc-card @(esCompacta ? "cc-card-sm" : "") @(esCriatura ? "cc-card-criatura" : "")">
    <!-- Hasta 2 cuadritos de habilidad arriba a la izquierda -->
    @if (habilidades.Count > 0)
    {
        <div class="cc-card-top-left-group">
            @foreach (var item in habilidades.Take(2))
            {
                <div class="cc-icon-badge" style="@(esCompacta ? "width:28px;height:28px;" : "")" title="@item.Hab.Tipo">
                    @Html.Raw(IconoSvg(item.Hab.Tipo, esCompacta ? 14 : 17))
                </div>
            }
        </div>
    }

    <!-- Centro superior: Maná (círculo) alternando con Vida (corazón) en Criaturas -->
    <div class="cc-card-top-center cc-toggle-mana-vida" title="@(esCriatura ? "Criatura: alterna Maná / Vida" : "Coste de maná")">
        <div class="cc-mana-circle" style="@(esCompacta ? "width:34px;height:34px;font-size:0.88rem;" : "")">@Model.CosteMana</div>
        @if (esCriatura)
        {
            <div class="cc-heart-wrap d-none">
                <svg viewBox="0 0 40 38" width="@(esCompacta ? 36 : 42)" height="@(esCompacta ? 34 : 40)" fill="#ffffff" stroke="#212529" stroke-width="2">
                    <path d="M20 35 C20 35 4 24 4 13 C4 7 8.5 3 13.5 3 C16.8 3 19 4.8 20 7 C21 4.8 23.2 3 26.5 3 C31.5 3 36 7 36 13 C36 24 20 35 20 35 Z" />
                </svg>
                <span class="cc-heart-num" style="@(esCompacta ? "font-size:0.8rem;" : "")">@(Model.Vida ?? 0)</span>
            </div>
        }
    </div>

    <!-- Derecha superior: Espada + Ataque (Criatura) o 3er efecto (Hechizo) -->
    @if (esCriatura)
    {
        <div class="cc-card-top-right" style="@(esCompacta ? "height:30px;font-size:0.78rem;padding:0 5px;" : "")" title="Ataque">
            @Html.Raw(IconoSvg(TipoHabilidad.Ataque, esCompacta ? 14 : 17))
            <span>@(Model.Ataque ?? 0)</span>
        </div>
    }
    else if (habilidades.Count >= 3)
    {
        <div class="cc-card-top-right" style="@(esCompacta ? "height:30px;padding:0 5px;" : "")" title="@habilidades[2].Hab.Tipo">
            @Html.Raw(IconoSvg(habilidades[2].Hab.Tipo, esCompacta ? 14 : 17))
        </div>
    }

    <!-- Ilustración -->
    <div class="cc-art-box @(esCompacta ? "cc-art-sm mt-1" : "mt-2")">
        @if (!string.IsNullOrEmpty(imgUrl))
        {
            <img src="@imgUrl" alt="@Model.Nombre" />
        }
        else
        {
            <span class="cc-art-label">Ilustración</span>
        }
    </div>

    <!-- Línea de rareza -->
    <div class="cc-rarity-divider @(esCompacta ? "my-1" : "")">@Model.Rareza</div>

    <!-- Nombre -->
    <div class="fw-semibold text-center small text-truncate mb-1">@Model.Nombre</div>

    <!-- Descripción estructurada por líneas con negritas, iconos vectoriales y descripciones personalizadas intercaladas -->
    @{
        List<string> PartirEnLineas(string texto, int maxPorLinea = 30, int maxLineas = 2)
        {
            var limpio = (texto ?? string.Empty).Trim();
            var res = new List<string>();
            if (string.IsNullOrEmpty(limpio)) return res;

            var restante = limpio;
            while (restante.Length > 0 && res.Count < maxLineas)
            {
                if (restante.Length <= maxPorLinea)
                {
                    res.Add(restante);
                    break;
                }
                if (res.Count == maxLineas - 1)
                {
                    res.Add(restante[..maxPorLinea].TrimEnd());
                    break;
                }
                int corte = restante.LastIndexOf(' ', maxPorLinea);
                if (corte > 0)
                {
                    res.Add(restante[..corte].TrimEnd());
                    restante = restante[(corte + 1)..].TrimStart();
                }
                else
                {
                    res.Add(restante[..maxPorLinea]);
                    restante = restante[maxPorLinea..];
                }
            }
            return res;
        }

        // Reconstruir secuencia intercalada (habilidades + descripciones entrecomilladas) en el mismo orden
        var elementosOrdenados = new List<(bool EsDesc, string Texto, (TipoEstado Estado, CraftCaster.Domain.Entities.Habilidad Hab)? HabItem)>();
        var lineasGuardadas = (Model.Descripcion ?? string.Empty)
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .ToList();

        int habCursor = 0;
        bool tieneFormatoPersonalizado = lineasGuardadas.Any(l => l.Length >= 2 && l.StartsWith('"') && l.EndsWith('"'));
        if (tieneFormatoPersonalizado)
        {
            foreach (var linea in lineasGuardadas)
            {
                if (linea.Length >= 2 && linea.StartsWith('"') && linea.EndsWith('"'))
                {
                    elementosOrdenados.Add((true, linea[1..^1], null));
                }
                else if (!linea.StartsWith("Criatura ") && !linea.StartsWith("Hechizo") && habCursor < habilidades.Count)
                {
                    elementosOrdenados.Add((false, string.Empty, habilidades[habCursor++]));
                }
            }
        }
        while (habCursor < habilidades.Count)
        {
            elementosOrdenados.Add((false, string.Empty, habilidades[habCursor++]));
        }
    }
    <div class="cc-card-desc text-body-secondary text-center">
        @if (esCriatura)
        {
            <div class="cc-line text-dark">
                <span>Criatura</span>
                <strong>@(Model.Ataque ?? 0)/@(Model.Vida ?? 0)</strong>
            </div>
        }
        else
        {
            <div class="cc-line text-dark">
                <span>Hechizo ·</span>
                <strong>Al entrar</strong>
            </div>
        }

        @if (elementosOrdenados.Count == 0 && !string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            foreach (var sub in PartirEnLineas(Model.Descripcion, 30, 3))
            {
                <div class="cc-line">@sub</div>
            }
        }

        @foreach (var elem in elementosOrdenados)
        {
            if (elem.EsDesc)
            {
                foreach (var sub in PartirEnLineas(elem.Texto, 30, 2))
                {
                    <div class="cc-line fst-italic">@sub</div>
                }
            }
            else if (elem.HabItem is { } item)
            {
                <div class="cc-line">
                    @if (esCriatura)
                    {
                        <span class="fw-semibold text-dark">@TextoCuando(item.Estado, item.Hab.Tipo):</span>
                    }
                    <span class="cc-inline-ico">@Html.Raw(IconoSvg(item.Hab.Tipo, 13))</span>
                    <strong class="text-dark">@item.Hab.Cantidad</strong>
                    @if (item.Hab.Tipo == TipoHabilidad.Robar)
                    {
                        <span>carta(s)</span>
                    }
                    else if (item.Hab.Tipo == TipoHabilidad.Descartar)
                    {
                        <span>mano rival</span>
                    }
                    else if (item.Hab.Tipo == TipoHabilidad.Destruir)
                    {
                        <span>carta (@TextoObjetivo(item.Hab.TipoObjetivo))</span>
                    }
                    else if (item.Hab.Tipo == TipoHabilidad.Defensa)
                    {
                        <span>al atacante</span>
                    }
                    else
                    {
                        <span>a @TextoObjetivo(item.Hab.TipoObjetivo)</span>
                    }
                </div>
            }
        }
    </div>
</div>
