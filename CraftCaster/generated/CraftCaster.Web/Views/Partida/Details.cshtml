@model CraftCaster.Web.ViewModels.PartidaViewModel

@{
    ViewData["Title"] = "Detalles";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Detalles</span>
                <h1 class="h3 mb-1">Partida</h1>
                <p class="text-body-secondary mb-0">Review the complete record information.</p>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 gy-2">
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Id)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Id)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Estado)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Estado)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Ganador)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Ganador)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.FechaInicio)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.FechaInicio)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Usuario1Label)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Usuario1Label)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Usuario2Label)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Usuario2Label)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Mazo1Label)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Mazo1Label)</dd>
            <dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.Mazo2Label)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Mazo2Label)</dd>
                </dl>


                <aside class="alert alert-info">
                    <h2 class="h6">Turnos</h2>
                    <p>Guarda este registro y gestiona Turnos desde Turno, seleccionando Partida en su formulario.</p>
                    <a asp-controller="Turno" asp-action="Index" class="btn btn-outline-primary">Gestionar Turnos</a>
                </aside>

                <aside class="alert alert-info">
                    <h2 class="h6">Jugadores</h2>
                    <p>Guarda este registro y gestiona Jugadores desde JugadorPartida, seleccionando Partida en su formulario.</p>
                    <a asp-controller="JugadorPartida" asp-action="Index" class="btn btn-outline-primary">Gestionar Jugadores</a>
                </aside>
            </div>
            <div class="card-footer bg-body p-4">
                <div class="d-flex flex-column flex-sm-row gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
            </div>
        </div>
    </div>
</div>
