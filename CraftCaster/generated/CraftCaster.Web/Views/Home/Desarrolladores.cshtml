@{
    ViewData["Title"] = "Desarrolladores";
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <span class="badge text-bg-primary-subtle text-primary-emphasis mb-2">Equipo CraftCaster</span>
        <h1 class="h3 mb-1">Desarrolladores</h1>
        <p class="text-body-secondary mb-0">Reparto de áreas y responsabilidades del proyecto de grupo.</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    <div class="col">
        <article class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="h5 mb-0">Antonio</h2>
                    <span class="badge text-bg-primary">Gestión, moderación y arquitectura</span>
                </div>
                <p class="text-body-secondary small mb-3">Responsable de la estructura general, navegación, portada y herramientas de administración.</p>
                <ul class="small mb-0 ps-3">
                    <li>Layout principal, cabecera con sesión y pie de página</li>
                    <li>Portada (Home) con mazos más famosos</li>
                    <li>Página estática de Desarrolladores</li>
                    <li>Panel de administración, moderación y control de acceso por roles</li>
                </ul>
            </div>
        </article>
    </div>

    <div class="col">
        <article class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="h5 mb-0">Álvaro</h2>
                    <span class="badge text-bg-secondary">Autenticación y catálogo de mazos</span>
                </div>
                <p class="text-body-secondary small mb-3">Responsable del acceso de usuarios, perfil personal y exploración pública de mazos.</p>
                <ul class="small mb-0 ps-3">
                    <li>Login y registro de usuarios</li>
                    <li>Mi cuenta (cartas, mazos y partidas del usuario)</li>
                    <li>Explorar mazos con búsqueda, filtros y ordenación</li>
                    <li>Detalle de mazo y sistema de valoración</li>
                </ul>
            </div>
        </article>
    </div>

    <div class="col">
        <article class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="h5 mb-0">Pau</h2>
                    <span class="badge text-bg-secondary">Bloques, lienzo y lógica de cartas</span>
                </div>
                <p class="text-body-secondary small mb-3">Responsable de la creación de cartas, gestión de habilidades y montaje de mazos.</p>
                <ul class="small mb-0 ps-3">
                    <li>Creador de cartas con estados y habilidades</li>
                    <li>Detalle de carta y listado de mis cartas</li>
                    <li>Editor de mazos con recuento y curva de maná</li>
                </ul>
            </div>
        </article>
    </div>

    <div class="col">
        <article class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="h5 mb-0">Jesús</h2>
                    <span class="badge text-bg-secondary">Tablero de combate y duelos</span>
                </div>
                <p class="text-body-secondary small mb-3">Responsable del flujo de partidas y del combate por turnos entre jugadores.</p>
                <ul class="small mb-0 ps-3">
                    <li>Sala de opciones de partida (crear, unirse y abandonar)</li>
                    <li>Tablero de partida (vida, maná, mano, campo, descarte y turnos)</li>
                    <li>Fin de partida y proclamación de ganador</li>
                </ul>
            </div>
        </article>
    </div>
</div>
