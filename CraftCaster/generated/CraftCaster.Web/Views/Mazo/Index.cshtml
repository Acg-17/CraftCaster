@model IEnumerable<CraftCaster.Web.ViewModels.MazoViewModel>

@{
    ViewData["Title"] = "Mazo";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-4">
        <div>
            <h1 class="h3 mb-1">Mazo</h1>
            <p class="text-body-secondary mb-0">Consulta y gestiona los registros disponibles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Crear</a>
    </div>
    <div class="card-body p-0">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Html.DisplayNameFor(model => model.Id)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.CosteMedio)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.NumCartas)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.EstadoMazo)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.EsPublico)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Valoracion)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.Imagen)</th>
                        <th scope="col">@Html.DisplayNameFor(model => model.UsuarioLabel)</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                            <td>@Html.DisplayFor(modelItem => item.CosteMedio)</td>
                            <td>@Html.DisplayFor(modelItem => item.NumCartas)</td>
                            <td>@Html.DisplayFor(modelItem => item.EstadoMazo)</td>
                            <td>@Html.DisplayFor(modelItem => item.EsPublico)</td>
                            <td>@Html.DisplayFor(modelItem => item.Valoracion)</td>
                            <td>@Html.DisplayFor(modelItem => item.Imagen)</td>
                            <td>@Html.DisplayFor(modelItem => item.UsuarioLabel)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center p-5">
            <h2 class="h5">Todavía no hay registros</h2>
            <p class="text-body-secondary">Crea el primer registro para comenzar.</p>
            <a asp-action="Create" class="btn btn-primary">Crear</a>
        </div>
    }
    </div>
</div>
