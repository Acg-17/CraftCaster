@model IEnumerable<CraftCaster.Web.ViewModels.AccionViewModel>

<h2 class="h5 mt-4">Acciones</h2>
<table class="table">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(model => model.Name)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.OrigenLabel)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <partial name="_AccionesDetailsItem" model="item" />
        }
    </tbody>
</table>
