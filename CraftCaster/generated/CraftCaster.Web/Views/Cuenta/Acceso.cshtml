@model CraftCaster.Web.ViewModels.AccesoViewModel
@{
    ViewData["Title"] = "Acceso";
    // Solo se pinta la alerta si hay un error de verdad (si no, sale una banda roja vacia)
    string? ErrorDe(string clave) =>
        ViewData.ModelState.TryGetValue(clave, out var entrada) && entrada.Errors.Count > 0
            ? entrada.Errors[0].ErrorMessage
            : null;
    var errorLogin = ErrorDe("Login");
    var errorRegistro = ErrorDe("Registro");
}

<div class="row g-4 justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Iniciar sesión</h1>
                <p class="text-body-secondary small mb-4">Accede a tu perfil y recupera tus mazos y creaciones.</p>

                <form asp-action="Entrar" method="post" novalidate>
                    @if (TempData["Exito"] is string exito)
                    {
                        <div class="alert alert-success py-2" role="status">@exito</div>
                    }
                    @if (TempData["Error"] is string errorTemp)
                    {
                        <div class="alert alert-danger py-2" role="alert">@errorTemp</div>
                    }
                    @if (errorLogin is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@errorLogin</div>
                    }
                    <input asp-for="Login.ReturnUrl" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="Login.Identificador" class="form-label fw-semibold"></label>
                        <input asp-for="Login.Identificador" class="form-control" autocomplete="username"
                               placeholder="alvaro@craftcaster.com" />
                        <span asp-validation-for="Login.Identificador" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Login.Contrasenia" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Login.Contrasenia" class="form-control" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary js-ver-contrasenia"
                                    aria-label="Mostrar contraseña">
                                <svg class="icono-ojo" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="icono-ojo-tachado d-none" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path
                                    d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Login.Contrasenia" class="text-danger small"></span>
                        <div class="text-end mt-1">
                            <a asp-action="RecuperarContrasenia" class="small text-decoration-none">¿Olvidaste tu contraseña?</a>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-dark w-100">Entrar a CraftCaster</button>
                </form>

                <div class="d-flex align-items-center my-3">
                    <hr class="flex-grow-1" />
                    <span class="px-2 small text-body-secondary">o</span>
                    <hr class="flex-grow-1" />
                </div>

                <a asp-action="AccesoGoogle" asp-route-returnUrl="@Model.Login.ReturnUrl" class="btn btn-outline-dark w-100 d-inline-flex align-items-center justify-content-center gap-2">
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.2-2.27H12v4.3h6.45a5.52 5.52 0 0 1-2.4 3.62v3h3.88c2.27-2.09 3.56-5.17 3.56-8.65z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.07 7.93-2.91l-3.88-3c-1.07.72-2.45 1.15-4.05 1.15-3.12 0-5.76-2.11-6.7-4.95H1.29v3.1A12 12 0 0 0 12 24z"/>
                        <path fill="#FBBC05" d="M5.3 14.29A7.2 7.2 0 0 1 4.92 12c0-.79.14-1.56.38-2.29V6.61H1.29A12 12 0 0 0 0 12c0 1.94.46 3.77 1.29 5.39l4.01-3.1z"/>
                        <path fill="#EA4335" d="M12 4.75c1.76 0 3.34.61 4.58 1.8l3.44-3.44C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.29 6.61l4.01 3.1C6.24 6.86 8.88 4.75 12 4.75z"/>
                    </svg>
                    <span>Continuar con Google</span>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-5" id="registro">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h4 mb-1">Crear cuenta</h2>
                <p class="text-body-secondary small mb-4">Regístrate para guardar tus cartas y jugar en la arena.</p>

                <form asp-action="Registrarse" method="post" novalidate>
                    @if (errorRegistro is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert">@errorRegistro</div>
                    }
                    <div class="mb-3">
                        <label asp-for="Registro.NombreUsuario" class="form-label fw-semibold"></label>
                        <input asp-for="Registro.NombreUsuario" class="form-control" autocomplete="username"
                               placeholder="Ej: PauCremades" />
                        <span asp-validation-for="Registro.NombreUsuario" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Registro.Email" class="form-label fw-semibold"></label>
                        <input asp-for="Registro.Email" class="form-control" autocomplete="email"
                               placeholder="tu@correo.com" />
                        <span asp-validation-for="Registro.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Registro.Contrasenia" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Registro.Contrasenia" class="form-control" autocomplete="new-password"
                                   placeholder="Mínimo 8 caracteres" />
                            <button type="button" class="btn btn-outline-secondary js-ver-contrasenia"
                                    aria-label="Mostrar contraseña">
                                <svg class="icono-ojo" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                                <svg class="icono-ojo-tachado d-none" width="18" height="18" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path
                                    d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                    <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                                    <line x1="1" y1="1" x2="23" y2="23" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Registro.Contrasenia" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-outline-dark w-100">Registrarse y empezar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll('.js-ver-contrasenia').forEach(function (boton) {
            boton.addEventListener('click', function () {
                var input = boton.parentElement.querySelector('input');
                var oculta = input.type === 'password';
                input.type = oculta ? 'text' : 'password';
                boton.querySelector('.icono-ojo').classList.toggle('d-none', oculta);
                boton.querySelector('.icono-ojo-tachado').classList.toggle('d-none', !oculta);
                boton.setAttribute('aria-label', oculta ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        });
    </script>
}
