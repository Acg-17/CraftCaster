@model CraftCaster.Web.ViewModels.RecuperarContraseniaViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Recuperar contraseña</h1>
                <p class="text-body-secondary small mb-4">
                    Escribe el correo de tu cuenta y te enviaremos un enlace para elegir una contraseña nueva.
                    El enlace caduca en 30 minutos y solo se puede usar una vez.
                </p>

                @if (TempData["Error"] is string errorTemp)
                {
                    <div class="alert alert-danger py-2" role="alert">@errorTemp</div>
                }

                <form asp-action="RecuperarContrasenia" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark">Enviar enlace</button>
                        <a asp-action="Acceso" class="btn btn-outline-secondary">Volver a iniciar sesión</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
