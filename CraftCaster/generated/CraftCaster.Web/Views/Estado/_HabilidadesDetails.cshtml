@model IEnumerable<CraftCaster.Web.ViewModels.HabilidadViewModel>

<h2 class="h5 mt-4">Habilidades</h2>
<table class="table">
    <thead>
        <tr>
            <th scope="col">@Html.DisplayNameFor(model => model.Tipo)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Cantidad)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.TipoObjetivo)</th>
            <th scope="col">@Html.DisplayNameFor(model => model.Objetivo)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <partial name="_HabilidadesDetailsItem" model="item" />
        }
    </tbody>
</table>
