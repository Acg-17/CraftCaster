@model CraftCaster.Web.ViewModels.CartaTableroViewModel
@using CraftCaster.Domain.Enums
@using CraftCaster.Web.Services
@{
    var zona = ViewData["Zona"] as string ?? "Mano";
    var esCriatura = Model.Tipo == TipoCarta.Criatura;
    var enMesa = zona is "CampoPropio" or "CampoRival";
    var enMano = zona == "Mano";
    var esCampoPropio = zona == "CampoPropio";
    var esCampoRival = zona == "CampoRival";
    var estaDanyada = esCriatura && enMesa && Model.VidaActual < Model.VidaBase;

    string IconoSvg(TipoHabilidad tipo, int size = 14) => tipo switch
    {
        TipoHabilidad.Ataque => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><path d='M14.5 3.5L20.5 3.5L20.5 9.5L10 20L4 14L14.5 3.5Z'/><line x1='3' y1='21' x2='7' y2='17'/><line x1='6' y1='12' x2='12' y2='18'/></svg>",
        TipoHabilidad.Danyo => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><polygon points='13 2 4 14 11 14 10 22 20 10 13 10 13 2'/></svg>",
        TipoHabilidad.Cura => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><path d='M12 20 C12 20 4 14 4 8.5 C4 5.5 6.5 3.5 9 3.5 C10.6 3.5 11.6 4.4 12 5.5 C12.4 4.4 13.4 3.5 15 3.5 C17.5 3.5 20 5.5 20 8.5 C20 14 12 20 12 20 Z'/><line x1='12' y1='8.5' x2='12' y2='14.5'/><line x1='9' y1='11.5' x2='15' y2='11.5'/></svg>",
        TipoHabilidad.Robar => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><rect x='7' y='4' width='12' height='16' rx='1.5'/><line x1='4' y1='12' x2='10' y2='12'/><line x1='7' y1='9' x2='7' y2='15'/></svg>",
        TipoHabilidad.Descartar => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><polyline points='3 6 5 6 21 6'/><path d='M6 6L7 20H17L18 6'/><line x1='10' y1='10' x2='10' y2='16'/><line x1='14' y1='10' x2='14' y2='16'/></svg>",
        TipoHabilidad.Destruir => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><circle cx='12' cy='9' r='5'/><circle cx='10' cy='8.5' r='0.8' fill='#212529'/><circle cx='14' cy='8.5' r='0.8' fill='#212529'/><line x1='5' y1='19' x2='19' y2='15'/><line x1='5' y1='15' x2='19' y2='19'/></svg>",
        TipoHabilidad.Defensa => $"<svg viewBox='0 0 24 24' width='{size}' height='{size}' fill='none' stroke='#212529' stroke-width='2'><path d='M12 3L4 6V12C4 16.5 7.5 19.5 12 21C16.5 19.5 20 16.5 20 12V6L12 3Z'/></svg>",
        _ => ""
    };

    string TextoCuando(TipoEstado est, TipoHabilidad hab)
    {
        if (hab == TipoHabilidad.Defensa) return "Al defender";
        return est switch
        {
            TipoEstado.Entrar => "Al entrar",
            TipoEstado.Atacar => "Al atacar",
            TipoEstado.InicioTurno => "Inicio turno",
            TipoEstado.FinTurno => "Fin turno",
            TipoEstado.Morir => "Al morir",
            _ => "Al entrar"
        };
    }

    string TextoObjetivo(TipoObjetivo obj) => obj switch
    {
        TipoObjetivo.Jugador => "Jugador",
        TipoObjetivo.Enemigo => "Enemigo",
        TipoObjetivo.Libre => "Objetivo",
        TipoObjetivo.TodosEnemigos => "Todos enemigos",
        TipoObjetivo.Self => "Sí mismo",
        _ => "Enemigo"
    };

    var clasesEstado = "";
    if (enMano)
    {
        clasesEstado = Model.SePuedeLanzar ? "cc-playable" : "cc-unplayable";
    }
    else if (esCampoPropio && Model.PuedeAtacarAhora)
    {
        clasesEstado = "cc-can-attack";
    }

    var vidaMostrar = enMesa ? Model.VidaActual : Model.VidaBase;
    var ataqueMostrar = enMesa ? Model.AtaqueActual : Model.AtaqueBase;
}

<div class="cc-card cc-card-board @(esCriatura ? "cc-card-criatura" : "cc-card-hechizo") @clasesEstado"
     data-card-id="@Model.CartaPartidaId"
     data-card-name="@Model.Nombre"
     data-card-zone="@zona"
     data-card-type="@((int)Model.Tipo)"
     data-playable="@(enMano && Model.SePuedeLanzar ? "true" : "false")"
     data-can-attack="@(esCampoPropio && Model.PuedeAtacarAhora ? "true" : "false")"
     data-target-mode="@((int)Model.ModoObjetivo)"
     data-enemy-creature="@(esCampoRival ? "true" : "false")"
     data-own-creature="@(esCampoPropio ? "true" : "false")">

    <!-- Hasta 2 cuadritos de habilidad arriba a la izquierda -->
    @if (Model.Habilidades.Count > 0)
    {
        <div class="cc-card-top-left-group">
            @foreach (var hab in Model.Habilidades.Take(2))
            {
                <div class="cc-icon-badge" title="@hab.Tipo">
                    @Html.Raw(IconoSvg(hab.Tipo, 14))
                </div>
            }
        </div>
    }

    <!-- Centro superior: en Mesa muestra Vida actual (corazón); en Mano muestra Coste de Maná (círculo) -->
    <div class="cc-card-top-center" title="@(enMesa && esCriatura ? $"Vida actual: {vidaMostrar}" : $"Coste de maná: {Model.CosteMana}")">
        @if (enMesa && esCriatura)
        {
            <div class="cc-heart-wrap @(estaDanyada ? "cc-heart-damaged" : "")">
                <svg viewBox="0 0 40 38" width="38" height="36" fill="#ffffff" stroke="#212529" stroke-width="2.2">
                    <path d="M20 35 C20 35 4 24 4 13 C4 7 8.5 3 13.5 3 C16.8 3 19 4.8 20 7 C21 4.8 23.2 3 26.5 3 C31.5 3 36 7 36 13 C36 24 20 35 20 35 Z" />
                </svg>
                <span class="cc-heart-num">@vidaMostrar</span>
            </div>
        }
        else
        {
            <div class="cc-mana-circle">@Model.CosteMana</div>
        }
    </div>

    <!-- Derecha superior: Espada + Ataque (Criatura) o 3er efecto (Hechizo) -->
    @if (esCriatura)
    {
        <div class="cc-card-top-right" title="Ataque: @ataqueMostrar">
            @Html.Raw(IconoSvg(TipoHabilidad.Ataque, 14))
            <span>@ataqueMostrar</span>
        </div>
    }
    else if (Model.Habilidades.Count >= 3)
    {
        <div class="cc-card-top-right" title="@Model.Habilidades[2].Tipo">
            @Html.Raw(IconoSvg(Model.Habilidades[2].Tipo, 14))
        </div>
    }

    <!-- Ilustración -->
    <div class="cc-art-box mt-1">
        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl" alt="@Model.Nombre" />
        }
        else
        {
            <span class="cc-art-label">@(esCriatura ? "Criatura" : "Instantáneo")</span>
        }
    </div>

    <!-- Línea de rareza -->
    <div class="cc-rarity-divider">@Model.Rareza</div>

    <!-- Nombre -->
    <div class="fw-semibold text-center text-truncate cc-card-name mb-1" title="@Model.Nombre">@Model.Nombre</div>

    <!-- Estadísticas y habilidades estructuradas -->
    <div class="cc-card-desc text-body-secondary text-center">
        @if (esCriatura)
        {
            <div class="cc-line text-dark">
                <span>Criatura</span>
                <strong>@ataqueMostrar/@vidaMostrar</strong>
                @if (enMano)
                {
                    <span class="cc-inline-ico" title="Vida">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="#dc3545"><path d="M12 21s-7-4.5-9-9.5C1.5 7.8 4.2 4.5 7.5 4.5c1.9 0 3.6 1 4.5 2.5.9-1.5 2.6-2.5 4.5-2.5 3.3 0 6 3.3 4.5 7-2 5-9 9.5-9 9.5z"/></svg>
                    </span>
                }
            </div>
        }
        else
        {
            <div class="cc-line text-dark">
                <span>Instantáneo ·</span>
                <strong>Al lanzar</strong>
            </div>
        }

        @if (Model.Habilidades.Count == 0 && !string.IsNullOrWhiteSpace(Model.Descripcion))
        {
            <div class="cc-line">@Model.Descripcion</div>
        }
        @foreach (var hab in Model.Habilidades.Take(2))
        {
            <div class="cc-line">
                @if (esCriatura)
                {
                    <span class="fw-semibold text-dark">@TextoCuando(hab.Momento, hab.Tipo):</span>
                }
                <span class="cc-inline-ico">@Html.Raw(IconoSvg(hab.Tipo, 12))</span>
                <strong class="text-dark">@hab.Cantidad</strong>
                @if (hab.Tipo == TipoHabilidad.Robar)
                {
                    <span>carta(s)</span>
                }
                else if (hab.Tipo == TipoHabilidad.Descartar)
                {
                    <span>mano rival</span>
                }
                else if (hab.Tipo == TipoHabilidad.Destruir)
                {
                    <span>(@TextoObjetivo(hab.TipoObjetivo))</span>
                }
                else if (hab.Tipo == TipoHabilidad.Defensa)
                {
                    <span>al atacante</span>
                }
                else
                {
                    <span>a @TextoObjetivo(hab.TipoObjetivo)</span>
                }
            </div>
        }
    </div>

    <!-- Pie contextual interactivo -->
    <div class="cc-card-footer-tag">
        @if (enMano)
        {
            if (Model.SePuedeLanzar)
            {
                <span class="badge text-bg-primary w-100">
                    @(Model.ModoObjetivo == ModoObjetivoCarta.Ninguno ? "Lanzar" : "Elegir objetivo")
                </span>
            }
            else
            {
                <span class="badge text-bg-light border text-body-secondary w-100">
                    Coste @Model.CosteMana maná
                </span>
            }
        }
        else if (esCampoPropio)
        {
            if (Model.PuedeAtacarAhora)
            {
                <span class="badge text-bg-success w-100">Atacar</span>
            }
            else
            {
                <span class="badge text-bg-light border text-body-secondary w-100">Esperando</span>
            }
        }
    </div>
</div>
