<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CraftCaster.Domain"
                   namespace="CraftCaster.Domain.Entities">
  <class name="JugadorPartida" table="JugadorPartida">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Vida" type="Int32">
      <column name="vida" not-null="true"/>
    </property>
    <property name="NumJugador" type="Int32">
      <column name="numJugador" not-null="true"/>
    </property>
    <many-to-one name="Partida" class="Partida">
      <column name="FK_Partida_partida" not-null="true"/>
    </many-to-one>
    <bag name="Zonas" cascade="all-delete-orphan" inverse="true">
      <key>
        <column name="FK_JugadorPartida_jugador"/>
      </key>
      <one-to-many class="ZonaPartida"/>
    </bag>
  </class>
  <query name="JugadorPartidaReadAllHQL">from JugadorPartida</query>
</hibernate-mapping>
