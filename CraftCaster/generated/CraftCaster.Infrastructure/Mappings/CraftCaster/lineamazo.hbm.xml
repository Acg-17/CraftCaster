<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CraftCaster.Domain"
                   namespace="CraftCaster.Domain.Entities">
  <class name="LineaMazo" table="LineaMazo">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Cantidad" type="Int32">
      <column name="cantidad" not-null="true"/>
    </property>
    <many-to-one name="Mazo" class="Mazo">
      <column name="FK_Mazo_mazo" not-null="true"/>
    </many-to-one>
    <many-to-one name="Carta" class="Carta">
      <column name="FK_Carta_carta" not-null="true"/>
    </many-to-one>
  </class>
  <query name="LineaMazoReadAllHQL">from LineaMazo</query>
</hibernate-mapping>
