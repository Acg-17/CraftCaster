<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CraftCaster.Domain"
                   namespace="CraftCaster.Domain.Entities">
  <class name="Accion" table="Accion">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Name" type="CraftCaster.Domain.Enums.TipoAccion, CraftCaster.Domain">
      <column name="name" not-null="true"/>
    </property>
    <many-to-one name="Turno" class="Turno">
      <column name="FK_Turno_turno" not-null="true"/>
    </many-to-one>
    <many-to-one name="Origen" class="CartaPartida">
      <column name="FK_CartaPartida_origen"/>
    </many-to-one>
    <bag name="Objetivo">
      <key>
        <column name="FK_Accion_objetivo"/>
      </key>
      <one-to-many class="CartaPartida"/>
    </bag>
  </class>
  <query name="AccionReadAllHQL">from Accion</query>
</hibernate-mapping>
