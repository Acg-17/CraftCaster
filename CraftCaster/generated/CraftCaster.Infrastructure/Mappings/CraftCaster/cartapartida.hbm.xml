<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CraftCaster.Domain"
                   namespace="CraftCaster.Domain.Entities">
  <class name="CartaPartida" table="CartaPartida">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <many-to-one name="Zona" class="ZonaPartida">
      <column name="FK_ZonaPartida_zona" not-null="true"/>
    </many-to-one>
    <many-to-one name="Original" class="Carta">
      <column name="FK_Carta_original" not-null="true"/>
    </many-to-one>
  </class>
  <query name="CartaPartidaReadAllHQL">from CartaPartida</query>
</hibernate-mapping>
