<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="CraftCaster.Domain"
                   namespace="CraftCaster.Domain.Entities">
  <class name="Turno" table="Turno">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Mana" type="Int32">
      <column name="mana" not-null="true"/>
    </property>
    <many-to-one name="Partida" class="Partida">
      <column name="FK_Partida_partida" not-null="true"/>
    </many-to-one>
    <many-to-one name="Jugador" class="JugadorPartida">
      <column name="FK_JugadorPartida_jugador" not-null="true"/>
    </many-to-one>
    <bag name="Acciones" cascade="all-delete-orphan" inverse="true">
      <key>
        <column name="FK_Turno_turno"/>
      </key>
      <one-to-many class="Accion"/>
    </bag>
  </class>
  <query name="TurnoReadAllHQL">from Turno</query>
</hibernate-mapping>
